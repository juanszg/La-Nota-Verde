---
import Icon from '../icons/Icon.astro';
import { navigationItems } from '../data/navigation';
---
<aside id="app-sidebar" class="site-chrome fixed top-[72px] bottom-0 left-0 z-30 hidden w-48 flex-col border-r border-white/15 p-3 text-white backdrop-blur-xl transition-[width] duration-300 lg:flex" aria-label="Panel de navegación">
  <nav class="grid gap-1" aria-label="Secciones de la plataforma">
    {navigationItems.map(({ label, href, icon }) => <a href={href} class="sidebar-link glow-hover flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-white/85 transition hover:bg-white/15 hover:text-white focus-visible:outline-2 focus-visible:outline-white"><Icon name={icon} /><span>{label}</span></a>)}
  </nav>
  <div id="sidebar-socials" class="mt-auto flex items-center justify-center gap-2 rounded-2xl border border-white/20 bg-black/10 p-2">
    <a href="https://wa.me/?text=Hola%2C%20quiero%20empezar%20a%20aprender%20m%C3%BAsica%20con%20La%20Nota%20Verde" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-link" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z"/><path d="M9 8.5c.3-.6.6-.6.9-.6h.4c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4 0 .6.5.9 1.2 1.5 2.1 1.9.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .4-.2 1.2-.7 1.5-.5.4-1.1.5-1.8.3-2-.6-3.5-1.7-4.6-3.4-.7-1-1.1-2.1-1-2.8 0-.5.2-.9.3-1.1Z"/></svg></a>
    <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-link" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="social-solid" d="M13.2 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V4a22 22 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3V10H7v3h2.8v8z"/></svg></a>
    <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.7" cy="6.5" r=".8" class="social-fill"/></svg></a>
  </div>
</aside>
<script is:inline>
  const sidebar = document.querySelector('#app-sidebar');
  const sidebarToggle = document.querySelector('#sidebar-toggle');
  sidebarToggle?.addEventListener('click', () => {
    const compact = sidebar?.classList.toggle('w-48') === false;
    sidebar?.classList.toggle('w-18', compact);
    document.querySelector('#sidebar-socials')?.classList.toggle('sidebar-socials-compact', compact);
    sidebar?.querySelectorAll('.sidebar-link').forEach((item) => item.classList.toggle('justify-center', compact));
    sidebar?.querySelectorAll('.sidebar-link span, .sidebar-label, .sidebar-copy').forEach((item) => item.classList.toggle('hidden', compact));
    const main = document.querySelector('#contenido');
    main?.classList.toggle('lg:pl-48', !compact);
    main?.classList.toggle('lg:pl-18', compact);
    sidebarToggle.setAttribute('aria-expanded', String(!compact));
    sidebarToggle.setAttribute('aria-label', compact ? 'Expandir barra lateral' : 'Contraer barra lateral');
  });
</script>

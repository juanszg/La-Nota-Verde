---
import Icon from '../icons/Icon.astro';
---
<a href="/" class="group inline-flex items-center gap-2.5 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neon" aria-label="LA NOTA VERDE, ir al inicio">
  <span class="grid h-9 w-9 place-items-center rounded-xl bg-neon text-ink shadow-[0_0_24px_rgb(22_219_101_/_0.35)] transition group-hover:rotate-6"><Icon name="note" size={19} stroke={2.2} /></span>
  <span class="text-sm font-bold tracking-[0.12em] text-[var(--text-primary)]">LA NOTA <span class="text-neon">VERDE</span></span>
</a>

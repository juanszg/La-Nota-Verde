---
import Icon from '../icons/Icon.astro';
const brandWords = ['LA', 'NOTA', 'VERDE'];
let letterOffset = 0;
---
<a href="/" class="brand-link group inline-flex items-center gap-2.5 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neon" aria-label="LA NOTA VERDE, ir al inicio">
  <span class="grid h-9 w-9 place-items-center rounded-xl bg-neon text-ink shadow-[0_0_24px_rgb(22_219_101_/_0.35)] transition group-hover:rotate-6"><Icon name="note" size={19} stroke={2.2} /></span>
  <span class="brand-name" aria-hidden="true">
    {brandWords.map((word, wordIndex) => (
      <span class:list={['brand-word', wordIndex === 2 && 'brand-word-accent']}>
        {Array.from(word).map((letter) => {
          const index = letterOffset++;
          return <span class="brand-letter" style={`--letter-index:${index}`}>{letter}</span>;
        })}
      </span>
    ))}
  </span>
</a>

<style>
  .brand-name { display: inline-flex; align-items: baseline; gap: .34em; font-family: "MuseoModerno", ui-sans-serif, system-ui, sans-serif; font-size: .88rem; font-weight: 700; letter-spacing: .12em; line-height: 1.2; }
  .brand-word { display: inline-flex; gap: .015em; white-space: nowrap; }
  .brand-letter { display: inline-block; color: var(--text-primary); transition: color 360ms ease; }
  .brand-word-accent .brand-letter { color: var(--accent); }
  .brand-link:hover .brand-letter, .brand-link:focus-visible .brand-letter { animation: brand-bounce 620ms cubic-bezier(.2,.75,.3,1) both; animation-delay: calc(var(--letter-index) * 18ms); }
  .brand-link:hover .brand-letter:nth-of-type(3n + 1), .brand-link:focus-visible .brand-letter:nth-of-type(3n + 1) { color: color-mix(in srgb, var(--accent) 48%, var(--text-primary)); }
  .brand-link:hover .brand-letter:nth-of-type(3n + 2), .brand-link:focus-visible .brand-letter:nth-of-type(3n + 2) { color: color-mix(in srgb, var(--accent) 72%, var(--text-primary)); }
  .brand-link:hover .brand-letter:nth-of-type(3n), .brand-link:focus-visible .brand-letter:nth-of-type(3n) { color: var(--accent); }
  @keyframes brand-bounce { 0%, 100% { transform: translateY(0); } 38% { transform: translateY(-.2em); } 62% { transform: translateY(0); } 80% { transform: translateY(-.055em); } }
  @media (prefers-reduced-motion: reduce) { .brand-link:hover .brand-letter, .brand-link:focus-visible .brand-letter { animation: none; } }
</style>

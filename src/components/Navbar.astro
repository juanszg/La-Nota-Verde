---
import Brand from './Brand.astro';
import Icon from '../icons/Icon.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { navigationItems } from '../data/navigation';
---
<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color:var(--surface)]/85 backdrop-blur-xl">
  <div class="mx-auto flex h-18 max-w-[1600px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <button id="sidebar-toggle" class="hidden h-10 w-10 place-items-center rounded-xl text-[var(--text-primary)] transition hover:bg-neon/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neon lg:grid" type="button" aria-label="Contraer barra lateral" aria-expanded="true"><Icon name="menu" /></button>
      <Brand />
    </div>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {navigationItems.map(({ label, href }) => <a class="glow-hover rounded-xl px-3 py-2 text-sm text-[var(--text-muted)] transition hover:bg-neon/10 hover:text-[var(--text-primary)] focus-visible:outline-2 focus-visible:outline-neon" href={href}>{label}</a>)}
    </nav>
    <div class="flex items-center gap-1"><ThemeToggle /><button id="mobile-menu-toggle" class="grid h-10 w-10 place-items-center rounded-xl text-[var(--text-primary)] transition hover:bg-neon/10 md:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neon" type="button" aria-label="Abrir menú" aria-expanded="false"><Icon name="menu" /></button></div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-[var(--border)] px-4 py-3 md:hidden" aria-label="Navegación móvil">
    <div class="grid gap-1">{navigationItems.map(({ label, href }) => <a class="glow-hover rounded-xl px-3 py-2.5 text-sm text-[var(--text-muted)] hover:bg-neon/10 hover:text-[var(--text-primary)]" href={href}>{label}</a>)}</div>
  </nav>
</header>
<script is:inline>
  const mobileButton = document.querySelector('#mobile-menu-toggle');
  const mobileMenu = document.querySelector('#mobile-menu');
  mobileButton?.addEventListener('click', () => {
    const isOpen = mobileButton.getAttribute('aria-expanded') === 'true';
    mobileButton.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.classList.toggle('hidden', isOpen);
  });
</script>

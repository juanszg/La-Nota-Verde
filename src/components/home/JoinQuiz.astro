---
const questions = [
  {q:'¿Qué te llama de la música?',a:['Expresarme','Disfrutar y relajarme','Conectar con otras personas','Crear mis propias canciones']},
  {q:'¿Qué instrumento quieres aprender?',a:['Guitarra','Bajo','Teclado / piano','Batería','Canto / voz','Otro instrumento']},
  {q:'¿Qué género escuchas más?',a:['Rock','Pop','Metal','Indie / alternativo','Regional / latino','Jazz / blues','Otro']},
  {q:'¿Cuál es tu meta principal?',a:['Tocar mis canciones favoritas','Tocar en una banda','Componer música','Improvisar solos','Aprender por diversión']},
  {q:'¿Qué experiencia tienes?',a:['Empiezo desde cero','Sé algunos acordes','Toco canciones sencillas','Ya tengo experiencia']},
  {q:'¿Qué te gustaría tocar primero?',a:['Una canción completa','Un riff inolvidable','Un solo','Acompañar con acordes']},
  {q:'¿Qué sonido te inspira?',a:['Guitarras distorsionadas','Melodías acústicas','Ritmos potentes','Teclas y sintetizadores','La voz']},
  {q:'¿Cuánto tiempo podrías practicar?',a:['10 minutos al día','20–30 minutos','Una hora','Cuando encuentre el momento']},
  {q:'¿Cómo prefieres aprender?',a:['Paso a paso','Con canciones','Viendo y escuchando','Probando y explorando']},
  {q:'¿Qué te gustaría sentir al tocar?',a:['Confianza','Libertad','Emoción','Calma','Orgullo por avanzar']},
  {q:'¿Con quién te gustaría hacer música?',a:['Por mi cuenta','Con amistades','En una banda','Me da igual, quiero empezar']},
  {q:'¿Qué suele frenarte?',a:['No sé por dónde empezar','Me cuesta ser constante','Creo que no tengo talento','No tengo instrumento','Nada, estoy listo/a']},
  {q:'¿Qué equipo tienes disponible?',a:['Instrumento propio','Puedo conseguir uno','Solo mi celular por ahora','Todavía no lo sé']},
  {q:'¿Te interesa aprender teoría musical?',a:['Sí, quiero entender todo','Lo básico para tocar','Prefiero aprender con canciones','Más adelante']},
  {q:'¿Qué te gustaría lograr en 3 meses?',a:['Tocar 3 canciones','Cambiar acordes con fluidez','Tocar mi primer solo','Escribir una idea propia','Haber creado un hábito']},
  {q:'¿Cómo te llamamos?',a:['Escribe tu nombre'],text:true},
];
---
<section id="empezar" class="px-6 py-20 lg:px-8"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
  <div class="lg:sticky lg:top-28"><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Encuentra tu primer acorde</p><h2 class="mt-4 text-4xl font-bold sm:text-5xl">La música empieza contigo.</h2><p class="mt-5 text-sm leading-7 text-[var(--text-muted)]">Cuéntanos qué te mueve. Son 16 preguntas rápidas y al final tendrás un mensaje listo para compartir por WhatsApp.</p><div class="mt-8 rounded-2xl border border-neon/20 bg-neon/5 p-5"><span class="text-3xl text-[var(--accent)]">♪</span><p class="mt-3 text-xs leading-6 text-[var(--text-muted)]">No necesitas experiencia ni tener todo resuelto. Solo ganas de comenzar.</p></div></div>
  <div class="surface rounded-3xl p-6 sm:p-9"><div class="flex items-center justify-between text-[10px] uppercase tracking-widest text-[var(--text-muted)]"><span id="quiz-counter">Pregunta 1 de 16</span><span id="quiz-percent">6%</span></div><div class="mt-3 h-1 overflow-hidden rounded-full track-surface"><div id="quiz-progress" class="h-full rounded-full bg-neon transition-all" style="width:6%"></div></div><h3 id="quiz-question" class="mt-8 min-h-16 text-2xl font-bold"></h3><div id="quiz-answers" class="mt-5 grid gap-2 sm:grid-cols-2"></div><div class="mt-8 flex justify-between"><button id="quiz-back" class="rounded-xl px-4 py-3 text-xs text-[var(--text-muted)] transition control-hover disabled:opacity-30" disabled>← Anterior</button><button id="quiz-next" class="rounded-xl bg-neon px-5 py-3 text-xs font-bold text-ink transition hover:bg-white" disabled>Siguiente →</button></div><div id="quiz-finish" class="mt-5 hidden"><p class="text-xs leading-6 text-[var(--text-muted)]">Tu perfil está listo. Al continuar se abrirá WhatsApp con tus respuestas para que puedas enviarlas.</p><a id="quiz-whatsapp" target="_blank" rel="noopener noreferrer" class="mt-4 block rounded-xl bg-neon px-5 py-4 text-center text-xs font-bold text-ink transition hover:bg-white">Abrir WhatsApp y enviar mi perfil ↗</a></div></div>
</div></section>
<script is:inline define:vars={{questions}}>
  let current=0;const answers=Array(questions.length).fill('');const qEl=document.querySelector('#quiz-question'), answersEl=document.querySelector('#quiz-answers'), next=document.querySelector('#quiz-next'), back=document.querySelector('#quiz-back');
  function render(){const q=questions[current],pct=Math.round((current+1)/questions.length*100);document.querySelector('#quiz-counter').textContent=`Pregunta ${current+1} de ${questions.length}`;document.querySelector('#quiz-percent').textContent=`${pct}%`;document.querySelector('#quiz-progress').style.width=`${pct}%`;qEl.textContent=q.q;answersEl.innerHTML='';document.querySelector('#quiz-finish').classList.add('hidden');next.classList.remove('hidden');back.classList.remove('hidden');answersEl.className='mt-5 grid gap-2 sm:grid-cols-2';
  if(q.text){const input=document.createElement('input');input.type='text';input.maxLength=60;input.placeholder='Tu nombre';input.value=answers[current];input.className='sm:col-span-2 rounded-xl border border-[var(--border)] bg-black/20 px-4 py-4 text-sm text-[var(--text-primary)] outline-none focus:border-neon';input.addEventListener('input',()=>{answers[current]=input.value.trim();next.disabled=!answers[current];});answersEl.appendChild(input);next.disabled=!answers[current];input.focus();}
  else {q.a.forEach(option=>{const button=document.createElement('button');button.type='button';button.textContent=option;button.className=`glow-hover rounded-xl border px-4 py-4 text-left text-xs transition ${answers[current]===option?'border-neon bg-neon/15 text-[var(--accent)]':'border-[var(--border)] control-surface hover:border-neon/60 control-hover'}`;button.addEventListener('click',()=>{answers[current]=option;render();});answersEl.appendChild(button);});next.disabled=!answers[current];}
  back.disabled=current===0;if(current===questions.length-1){next.classList.add('hidden');back.classList.add('hidden');document.querySelector('#quiz-finish').classList.remove('hidden');} }
  next.addEventListener('click',()=>{if(current<questions.length-1){current++;render();}});back.addEventListener('click',()=>{if(current>0){current--;render();}});
  document.querySelector('#quiz-whatsapp').addEventListener('click',event=>{const message='¡Hola! Me gustaría empezar mi camino musical con La Nota Verde. Aquí va mi perfil:\n\n'+questions.map((q,i)=>`${q.q} ${answers[i]||'—'}`).join('\n')+'\n\n¡Quiero saber cómo empezar!';event.currentTarget.href=`https://wa.me/?text=${encodeURIComponent(message)}`;});render();
</script>

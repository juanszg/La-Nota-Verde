---
import Card from '../ui/Card.astro';
import Icon from '../../icons/Icon.astro';
import { upcomingModules } from '../../data/navigation';
---
<section id="ecosistema" class="px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl"><p class="text-xs font-semibold uppercase tracking-[0.18em] text-neon">Un ecosistema, una práctica</p><h2 class="mt-4 text-3xl font-bold tracking-[-0.04em] sm:text-4xl">Cada módulo tendrá un propósito claro.</h2><p class="mt-4 leading-7 text-[var(--text-muted)]">La base visual y técnica ya está preparada para crecer sin perder foco ni consistencia.</p></div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">{upcomingModules.map(({ title, description, icon }, index) => <Card><div class="flex items-start justify-between"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-neon/10 text-neon"><Icon name={icon} /></span><span class="text-xs text-[var(--text-muted)]">0{index + 1}</span></div><h3 class="mt-8 text-lg font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-[var(--text-muted)]">{description}</p><span class="mt-7 inline-flex items-center gap-2 text-xs font-semibold text-neon">Próximamente <Icon name="arrow" size={15} /></span></Card>)}</div>
  </div>
</section>

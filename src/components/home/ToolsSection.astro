---
const chords = [
  { name: 'A7', root: '5.ª cuerda', shape: 'x 0 2 0 2 0', frets: ['x','0','2','0','2','0'] },
  { name: 'Am7', root: '5.ª cuerda', shape: 'x 0 2 0 1 0', frets: ['x','0','2','0','1','0'] },
  { name: 'B7', root: '5.ª cuerda', shape: 'x 2 1 2 0 2', frets: ['x','2','1','2','0','2'] },
  { name: 'C7', root: '5.ª cuerda', shape: 'x 3 2 3 1 0', frets: ['x','3','2','3','1','0'] },
  { name: 'D7', root: '4.ª cuerda', shape: 'x x 0 2 1 2', frets: ['x','x','0','2','1','2'] },
  { name: 'Dm7', root: '4.ª cuerda', shape: 'x x 0 2 1 1', frets: ['x','x','0','2','1','1'] },
  { name: 'E7', root: '6.ª cuerda', shape: '0 2 0 1 0 0', frets: ['0','2','0','1','0','0'] },
  { name: 'Em7', root: '6.ª cuerda', shape: '0 2 0 0 0 0', frets: ['0','2','0','0','0','0'] },
  { name: 'F7', root: '6.ª cuerda', shape: '1 3 1 2 1 1', frets: ['1','3','1','2','1','1'] },
  { name: 'G7', root: '6.ª cuerda', shape: '3 2 0 0 0 1', frets: ['3','2','0','0','0','1'] },
];
---
<section id="herramientas" class="px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">01 / Afinador</span><span class="text-2xl">◉</span></div>
        <h3 class="mt-5 text-2xl font-bold">Clava la nota.</h3><p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Usa el micrófono para medir la afinación estándar de tu guitarra.</p>
        <div class="my-7 rounded-2xl border border-[var(--border)] bg-black/20 px-4 py-5 text-center"><div id="tuner-note" class="text-6xl font-bold text-[var(--accent)]">E</div><div id="tuner-status" class="mt-2 text-[10px] uppercase tracking-widest text-[var(--text-muted)]">Esperando señal</div><div class="relative mx-auto mt-5 h-1.5 max-w-48 rounded-full track-surface"><span class="absolute left-1/2 top-[-5px] h-4 w-px bg-[var(--text-muted)]"></span><span id="tuner-needle" class="absolute left-1/2 top-[-4px] h-3 w-1 rounded bg-neon transition-all"></span></div><div id="tuner-cents" class="mt-2 text-[10px] text-[var(--text-muted)]">0 cents</div></div>
        <button id="tuner-start" class="w-full rounded-xl bg-neon px-4 py-3 text-xs font-bold text-ink transition hover:bg-white">Activar micrófono</button>
        <p class="mt-3 text-center text-[9px] leading-4 text-[var(--text-muted)]">Afinación estándar · E A D G B E · requiere permiso del micrófono</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-start-2 lg:row-start-1">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">03 / Solfeo</span><span class="text-2xl">♫</span></div><h3 class="mt-5 text-2xl font-bold">Entrena el oído.</h3><p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">Toca cada nota y canta la escala. Do mayor, sin sostenidos ni bemoles.</p>
        <div class="mt-8 grid grid-cols-4 gap-2">{['Do','Re','Mi','Fa','Sol','La','Si','Do’'].map((note, i) => <button type="button" data-note={i} class="solfege-note glow-hover aspect-square rounded-xl border border-[var(--border)] control-surface text-sm font-bold transition hover:-translate-y-1 hover:border-neon hover:bg-neon/15 focus-visible:outline-2 focus-visible:outline-neon">{note}</button>)}</div>
        <button id="solfege-play" class="mt-4 w-full rounded-xl border border-neon/30 px-4 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">▶ Escuchar escala</button><p id="solfege-hint" class="mt-3 min-h-8 text-center text-[9px] leading-4 text-[var(--text-muted)]">Elige una nota o escucha la escala completa.</p>
      </article>
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-span-2 lg:row-start-2">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">02 / Acordes</span><span class="text-2xl">⌁</span></div><h3 class="mt-5 text-2xl font-bold">Cheatsheet 7.ª.</h3><p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">Acordes esenciales con raíz en 4.ª, 5.ª y 6.ª cuerda. Cuerdas de 6.ª a 1.ª.</p>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">{chords.map((chord) => <div class="rounded-xl border border-[var(--border)] bg-black/15 p-3"><div class="flex items-center justify-between"><b class="text-lg text-[var(--accent)]">{chord.name}</b><span class="text-[8px] text-[var(--text-muted)]">{chord.root}</span></div><div class="mt-2 flex gap-1">{chord.frets.map((fret) => <span class="grid h-7 w-6 place-items-center rounded control-surface font-mono text-[10px]">{fret}</span>)}</div><p class="mt-1 font-mono text-[8px] text-[var(--text-muted)]">{chord.shape}</p></div>)}</div>
        <p class="mt-4 text-[9px] leading-4 text-[var(--text-muted)]">Números = traste · 0 = cuerda al aire · x = no tocar. Diagramas en orden 6.ª → 1.ª.</p>
      </article>
    </div>
  </div>
</section>
<script is:inline>
  const noteNames = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
  let audioContext, stream, analyser, micBuffer;
  const tunerButton = document.querySelector('#tuner-start');
  tunerButton?.addEventListener('click', async () => {
    if (stream) { stream.getTracks().forEach(track => track.stop()); stream = null; tunerButton.textContent='Activar micrófono'; document.querySelector('#tuner-status').textContent='Micrófono pausado'; return; }
    try { stream = await navigator.mediaDevices.getUserMedia({audio:true}); audioContext = new AudioContext(); analyser = audioContext.createAnalyser(); analyser.fftSize=4096; audioContext.createMediaStreamSource(stream).connect(analyser); micBuffer=new Float32Array(analyser.fftSize); tunerButton.textContent='Pausar afinador'; document.querySelector('#tuner-status').textContent='Escuchando…'; detectPitch(); }
    catch { document.querySelector('#tuner-status').textContent='No se pudo acceder al micrófono'; }
  });
  function detectPitch(){ if(!stream)return; analyser.getFloatTimeDomainData(micBuffer); let rms=Math.sqrt(micBuffer.reduce((sum,v)=>sum+v*v,0)/micBuffer.length); if(rms>.012){let best=-1,score=0; for(let lag=35;lag<micBuffer.length/2;lag++){let s=0;for(let i=0;i<micBuffer.length/2;i++)s+=micBuffer[i]*micBuffer[i+lag];if(s>score){score=s;best=lag;}} if(best>0){let hz=audioContext.sampleRate/best;let midi=Math.round(69+12*Math.log2(hz/440));let target=440*Math.pow(2,(midi-69)/12);let cents=Math.round(1200*Math.log2(hz/target));let name=noteNames[(midi%12+12)%12];document.querySelector('#tuner-note').textContent=name;document.querySelector('#tuner-cents').textContent=`${cents>0?'+':''}${cents} cents`;document.querySelector('#tuner-status').textContent=cents===0?'Afinada':cents<0?'Sube la afinación':'Baja la afinación';document.querySelector('#tuner-needle').style.transform=`translateX(${Math.max(-45,Math.min(45,cents*1.5))}px)`;}} requestAnimationFrame(detectPitch); }
  const solfegeFreq=[261.63,293.66,329.63,349.23,392,440,493.88,523.25];
  function playSolfege(index){if(!window.AudioContext)return;const ctx=new AudioContext();const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type='sine';osc.frequency.value=solfegeFreq[index];gain.gain.setValueAtTime(.0001,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(.22,ctx.currentTime+.02);gain.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+.5);osc.connect(gain).connect(ctx.destination);osc.start();osc.stop(ctx.currentTime+.52);document.querySelector('#solfege-hint').textContent=`${['Do','Re','Mi','Fa','Sol','La','Si','Do’'][index]} · ${solfegeFreq[index]} Hz`;setTimeout(()=>ctx.close(),700);}
  document.querySelectorAll('.solfege-note').forEach(button=>button.addEventListener('click',()=>playSolfege(Number(button.dataset.note))));
  document.querySelector('#solfege-play')?.addEventListener('click',()=>{[0,1,2,3,4,5,6,7].forEach((n,i)=>setTimeout(()=>playSolfege(n),i*570));});
</script>

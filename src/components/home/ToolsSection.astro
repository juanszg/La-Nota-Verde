          <div class="flex items-end justify-between gap-3"><label for="metro-bpm" class="text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]">Tempo</label><output id="metro-bpm-value" for="metro-bpm" class="font-display text-4xl font-bold text-[var(--accent)]">90 <small class="text-xs">BPM</small></output></div>

---
const chords = [
  { name: 'A7', root: '5.ª cuerda', shape: 'x 0 2 0 2 0', frets: ['x','0','2','0','2','0'] },
  { name: 'Am7', root: '5.ª cuerda', shape: 'x 0 2 0 1 0', frets: ['x','0','2','0','1','0'] },
  { name: 'B7', root: '5.ª cuerda', shape: 'x 2 1 2 0 2', frets: ['x','2','1','2','0','2'] },
  { name: 'C7', root: '5.ª cuerda', shape: 'x 3 2 3 1 0', frets: ['x','3','2','3','1','0'] },
  { name: 'D7', root: '4.ª cuerda', shape: 'x x 0 2 1 2', frets: ['x','x','0','2','1','2'] },
  { name: 'Dm7', root: '4.ª cuerda', shape: 'x x 0 2 1 1', frets: ['x','x','0','2','1','1'] },
  { name: 'E7', root: '6.ª cuerda', shape: '0 2 0 1 0 0', frets: ['0','2','0','1','0','0'] },
  { name: 'Em7', root: '6.ª cuerda', shape: '0 2 0 0 0 0', frets: ['0','2','0','0','0','0'] },
  { name: 'F7', root: '6.ª cuerda', shape: '1 3 1 2 1 1', frets: ['1','3','1','2','1','1'] },
  { name: 'G7', root: '6.ª cuerda', shape: '3 2 0 0 0 1', frets: ['3','2','0','0','0','1'] },
];
---
<section id="herramientas" class="px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">01 / Afinador</span><span class="text-2xl">◉</span></div>
        <h3 class="mt-5 text-2xl font-bold">Clava la nota.</h3><p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Usa el micrófono para medir la afinación estándar de tu guitarra.</p>
        <div class="my-7 rounded-2xl border border-[var(--border)] bg-black/20 px-4 py-5 text-center"><div id="tuner-note" class="text-6xl font-bold text-[var(--accent)]">E</div><div id="tuner-status" class="mt-2 text-[10px] uppercase tracking-widest text-[var(--text-muted)]">Esperando señal</div><div class="relative mx-auto mt-5 h-1.5 max-w-48 rounded-full track-surface"><span class="absolute left-1/2 top-[-5px] h-4 w-px bg-[var(--text-muted)]"></span><span id="tuner-needle" class="absolute left-1/2 top-[-4px] h-3 w-1 rounded bg-neon transition-all"></span></div><div id="tuner-cents" class="mt-2 text-[10px] text-[var(--text-muted)]">0 cents</div></div>
        <button id="tuner-start" class="w-full rounded-xl bg-neon px-4 py-3 text-xs font-bold text-ink transition hover:bg-white">Activar micrófono</button>
        <p class="mt-3 text-center text-[9px] leading-4 text-[var(--text-muted)]">Afinación estándar · E A D G B E · requiere permiso del micrófono</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-start-2 lg:row-start-1">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">03 / Solfeo</span><span class="text-2xl">♫</span></div><h3 class="mt-5 text-2xl font-bold">Aprende la escala.</h3><p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">Toca cada nota y canta la escala. Do mayor, sin sostenidos ni bemoles.</p>
        <div class="mt-8 grid grid-cols-4 gap-2">{['Do','Re','Mi','Fa','Sol','La','Si','Do’'].map((note, i) => <button type="button" data-note={i} class="solfege-note glow-hover aspect-square rounded-xl border border-[var(--border)] control-surface text-sm font-bold transition hover:-translate-y-1 hover:border-neon hover:bg-neon/15 focus-visible:outline-2 focus-visible:outline-neon">{note}</button>)}</div>
        <button id="solfege-play" class="mt-4 w-full rounded-xl border border-neon/30 px-4 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">▶ Escuchar escala</button><p id="solfege-hint" class="mt-3 min-h-8 text-center text-[9px] leading-4 text-[var(--text-muted)]">Elige una nota o escucha la escala completa.</p>
      </article>
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-span-2 lg:row-start-2">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">02 / Acordes</span><span class="text-2xl">⌁</span></div><h3 class="mt-5 text-2xl font-bold">Cheatsheet 7.ª.</h3><p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">Acordes esenciales con raíz en 4.ª, 5.ª y 6.ª cuerda. Cuerdas de 6.ª a 1.ª.</p>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">{chords.map((chord) => <div class="rounded-xl border border-[var(--border)] bg-black/15 p-3"><div class="flex items-center justify-between"><b class="text-lg text-[var(--accent)]">{chord.name}</b><span class="text-[8px] text-[var(--text-muted)]">{chord.root}</span></div><div class="mt-2 flex gap-1">{chord.frets.map((fret) => <span class="grid h-7 w-6 place-items-center rounded control-surface font-mono text-[10px]">{fret}</span>)}</div><p class="mt-1 font-mono text-[8px] text-[var(--text-muted)]">{chord.shape}</p></div>)}</div>
        <p class="mt-4 text-[9px] leading-4 text-[var(--text-muted)]">Números = traste · 0 = cuerda al aire · x = no tocar. Diagramas en orden 6.ª → 1.ª.</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">04 / Juego de oído</span><span class="text-2xl">耳</span></div>
        <h3 class="mt-5 text-2xl font-bold">¿Qué intervalo escuchas?</h3>
        <p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Escucha dos notas y reconoce la distancia entre ellas. Puedes repetir el ejemplo antes de responder.</p>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[var(--border)] bg-black/15 p-3"><span class="text-[10px] uppercase tracking-wider text-[var(--text-muted)]">Puntuación</span><strong id="ear-score" class="text-xs text-[var(--accent)]" aria-live="polite">0 de 0</strong></div>
        <div class="mt-4 grid grid-cols-4 gap-2" role="group" aria-label="Elige el intervalo escuchado">
          <button type="button" data-ear-answer="1" aria-label="Segunda menor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">2ª m</button>
          <button type="button" data-ear-answer="2" aria-label="Segunda mayor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">2ª M</button>
          <button type="button" data-ear-answer="3" aria-label="Tercera menor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">3ª m</button>
          <button type="button" data-ear-answer="4" aria-label="Tercera mayor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">3ª M</button>
          <button type="button" data-ear-answer="5" aria-label="Cuarta justa" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">4ª J</button>
          <button type="button" data-ear-answer="6" aria-label="Cuarta aumentada o quinta disminuida" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">4ª A</button>
          <button type="button" data-ear-answer="7" aria-label="Quinta justa" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">5ª J</button>
          <button type="button" data-ear-answer="12" aria-label="Octava justa" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">8ª J</button>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2"><button type="button" id="ear-play" class="rounded-xl bg-neon px-3 py-3 text-xs font-bold text-ink transition hover:bg-white">▶ Escuchar</button><button type="button" id="ear-next" class="hidden rounded-xl border border-neon/30 px-3 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">Otro reto →</button></div>
        <p id="ear-feedback" class="mt-3 min-h-10 text-center text-[10px] leading-5 text-[var(--text-muted)]" aria-live="polite">Pulsa escuchar y elige la distancia entre las notas.</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">05 / Reto de ritmo</span><span class="text-2xl">♩</span></div>
        <h3 class="mt-5 text-2xl font-bold">Escucha el patrón.</h3>
        <p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Sigue el pulso grave y reconoce el ritmo de los golpes agudos en 4/4.</p>
        <label for="rhythm-tempo" class="mt-5 flex items-center justify-between text-[10px] uppercase tracking-wider text-[var(--text-muted)]"><span>Tempo</span><strong id="rhythm-tempo-label" class="text-[var(--accent)]">84 BPM</strong></label>
        <input id="rhythm-tempo" class="mt-3 w-full accent-[var(--accent)]" type="range" min="60" max="132" step="6" value="84" aria-label="Tempo del reto de ritmo" />
        <div class="mt-5 grid grid-cols-2 gap-2" role="group" aria-label="Elige el patrón rítmico">
          <button type="button" data-rhythm-answer="quarter" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Negras</button>
          <button type="button" data-rhythm-answer="eighth" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Corcheas</button>
          <button type="button" data-rhythm-answer="syncopated" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Síncopa</button>
          <button type="button" data-rhythm-answer="rests" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Con silencios</button>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2"><button type="button" id="rhythm-play" class="rounded-xl bg-neon px-3 py-3 text-xs font-bold text-ink transition hover:bg-white">▶ Escuchar ritmo</button><button type="button" id="rhythm-next" class="hidden rounded-xl border border-neon/30 px-3 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">Nuevo ritmo →</button></div>
        <p id="rhythm-feedback" class="mt-3 min-h-10 text-center text-[10px] leading-5 text-[var(--text-muted)]" aria-live="polite">Escucha las veces que necesites y luego elige una opción.</p>
        <p id="rhythm-score" class="text-center text-[9px] text-[var(--text-muted)]" aria-live="polite">Aciertos: 0 de 0</p>
      </article>
    </div>
  </div>
</section>
<script is:inline>
  const noteNames = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
  let audioContext, stream, analyser, micBuffer;
  const tunerButton = document.querySelector('#tuner-start');
  tunerButton?.addEventListener('click', async () => {
    if (stream) { stream.getTracks().forEach(track => track.stop()); stream = null; tunerButton.textContent='Activar micrófono'; document.querySelector('#tuner-status').textContent='Micrófono pausado'; return; }
    try { stream = await navigator.mediaDevices.getUserMedia({audio:true}); audioContext = new AudioContext(); analyser = audioContext.createAnalyser(); analyser.fftSize=4096; audioContext.createMediaStreamSource(stream).connect(analyser); micBuffer=new Float32Array(analyser.fftSize); tunerButton.textContent='Pausar afinador'; document.querySelector('#tuner-status').textContent='Escuchando…'; detectPitch(); }
    catch { document.querySelector('#tuner-status').textContent='No se pudo acceder al micrófono'; }
  });
  function detectPitch(){ if(!stream)return; analyser.getFloatTimeDomainData(micBuffer); let rms=Math.sqrt(micBuffer.reduce((sum,v)=>sum+v*v,0)/micBuffer.length); if(rms>.012){let best=-1,score=0; for(let lag=35;lag<micBuffer.length/2;lag++){let s=0;for(let i=0;i<micBuffer.length/2;i++)s+=micBuffer[i]*micBuffer[i+lag];if(s>score){score=s;best=lag;}} if(best>0){let hz=audioContext.sampleRate/best;let midi=Math.round(69+12*Math.log2(hz/440));let target=440*Math.pow(2,(midi-69)/12);let cents=Math.round(1200*Math.log2(hz/target));let name=noteNames[(midi%12+12)%12];document.querySelector('#tuner-note').textContent=name;document.querySelector('#tuner-cents').textContent=`${cents>0?'+':''}${cents} cents`;document.querySelector('#tuner-status').textContent=cents===0?'Afinada':cents<0?'Sube la afinación':'Baja la afinación';document.querySelector('#tuner-needle').style.transform=`translateX(${Math.max(-45,Math.min(45,cents*1.5))}px)`;}} requestAnimationFrame(detectPitch); }
  const solfegeFreq=[261.63,293.66,329.63,349.23,392,440,493.88,523.25];
  function playSolfege(index){if(!window.AudioContext)return;const ctx=new AudioContext();const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type='sine';osc.frequency.value=solfegeFreq[index];gain.gain.setValueAtTime(.0001,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(.22,ctx.currentTime+.02);gain.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+.5);osc.connect(gain).connect(ctx.destination);osc.start();osc.stop(ctx.currentTime+.52);document.querySelector('#solfege-hint').textContent=`${['Do','Re','Mi','Fa','Sol','La','Si','Do’'][index]} · ${solfegeFreq[index]} Hz`;setTimeout(()=>ctx.close(),700);}
  document.querySelectorAll('.solfege-note').forEach(button=>button.addEventListener('click',()=>playSolfege(Number(button.dataset.note))));
  document.querySelector('#solfege-play')?.addEventListener('click',()=>{[0,1,2,3,4,5,6,7].forEach((n,i)=>setTimeout(()=>playSolfege(n),i*570));});
</script>

<script is:inline>
  (() => {
    const AudioEngine = window.AudioContext;
    if (!AudioEngine) return;

    const intervals = [
      { semitones: 1, name: 'segunda menor' }, { semitones: 2, name: 'segunda mayor' },
      { semitones: 3, name: 'tercera menor' }, { semitones: 4, name: 'tercera mayor' },
      { semitones: 5, name: 'cuarta justa' }, { semitones: 6, name: 'cuarta aumentada' },
      { semitones: 7, name: 'quinta justa' }, { semitones: 12, name: 'octava justa' },
    ];
    let earContext;
    let currentInterval = null;
    let earAttempts = 0;
    let earCorrect = 0;
    const earFeedback = document.querySelector('#ear-feedback');
    const earAnswers = [...document.querySelectorAll('.ear-answer')];
    const earNext = document.querySelector('#ear-next');
    const earScore = document.querySelector('#ear-score');

    const playTone = (context, frequency, start, duration, volume, wave = 'sine') => {
      const oscillator = context.createOscillator();
      const gain = context.createGain();
      oscillator.type = wave;
      oscillator.frequency.setValueAtTime(frequency, start);
      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.exponentialRampToValueAtTime(volume, start + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + duration);
      oscillator.connect(gain).connect(context.destination);
      oscillator.start(start);
      oscillator.stop(start + duration + 0.02);
    };

    const newInterval = () => {
      currentInterval = intervals[Math.floor(Math.random() * intervals.length)];
      earFeedback.textContent = 'Pulsa escuchar y elige la distancia entre las notas.';
      earNext.classList.add('hidden');
      earAnswers.forEach((button) => {
        button.disabled = false;
        button.classList.remove('border-neon', 'text-[var(--accent)]', 'border-red-500', 'text-red-400');
      });
    };

    const playInterval = async () => {
      earContext ??= new AudioEngine();
      await earContext.resume();
      const baseMidi = 60 + Math.floor(Math.random() * 13);
      const start = earContext.currentTime + 0.08;
      const first = 440 * 2 ** ((baseMidi - 69) / 12);
      const second = first * 2 ** (currentInterval.semitones / 12);
      playTone(earContext, first, start, 0.42, 0.18);
      playTone(earContext, second, start + 0.62, 0.5, 0.18);
    };

    document.querySelector('#ear-play')?.addEventListener('click', playInterval);
    earNext?.addEventListener('click', newInterval);
    earAnswers.forEach((button) => button.addEventListener('click', () => {
      if (!currentInterval || button.disabled) return;
      earAttempts += 1;
      const correct = Number(button.dataset.earAnswer) === currentInterval.semitones;
      if (correct) earCorrect += 1;
      earScore.textContent = `${earCorrect} de ${earAttempts}`;
      earFeedback.textContent = correct
        ? `¡Correcto! Escuchaste una ${currentInterval.name} (${currentInterval.semitones} semitonos).`
        : `Era una ${currentInterval.name} (${currentInterval.semitones} semitonos). Escúchala otra vez y prueba el siguiente.`;
      button.classList.add(correct ? 'border-neon' : 'border-red-500', correct ? 'text-[var(--accent)]' : 'text-red-400');
      earAnswers.forEach((answer) => { answer.disabled = true; });
      earNext.classList.remove('hidden');
    }));
    newInterval();

    const patterns = [
      { id: 'quarter', name: 'negras', hits: [0, 2, 4, 6] },
      { id: 'eighth', name: 'corcheas', hits: [0, 1, 2, 3, 4, 5, 6, 7] },
      { id: 'syncopated', name: 'síncopa', hits: [0, 3, 4, 7] },
      { id: 'rests', name: 'golpes con silencios', hits: [0, 2, 6] },
    ];
    let currentPattern = null;
    let rhythmAttempts = 0;
    let rhythmCorrect = 0;
    let rhythmContext;
    const rhythmFeedback = document.querySelector('#rhythm-feedback');
    const rhythmAnswers = [...document.querySelectorAll('.rhythm-answer')];
    const rhythmNext = document.querySelector('#rhythm-next');
    const rhythmScore = document.querySelector('#rhythm-score');
    const tempoInput = document.querySelector('#rhythm-tempo');
    const tempoLabel = document.querySelector('#rhythm-tempo-label');

    const newPattern = () => {
      currentPattern = patterns[Math.floor(Math.random() * patterns.length)];
      rhythmFeedback.textContent = 'Escucha las veces que necesites y luego elige una opción.';
      rhythmNext.classList.add('hidden');
      rhythmAnswers.forEach((button) => { button.disabled = false; });
    };

    const playPattern = async () => {
      rhythmContext ??= new AudioEngine();
      await rhythmContext.resume();
      const bpm = Number(tempoInput.value);
      const beat = 60 / bpm;
      const start = rhythmContext.currentTime + 0.1;
      for (let step = 0; step < 8; step += 1) {
        const time = start + step * beat / 2;
        if (step % 2 === 0) playTone(rhythmContext, 175, time, 0.055, 0.045, 'triangle');
        if (currentPattern.hits.includes(step)) playTone(rhythmContext, 720, time, 0.09, 0.14, 'square');
      }
    };

    tempoInput?.addEventListener('input', () => { tempoLabel.textContent = `${tempoInput.value} BPM`; });
    document.querySelector('#rhythm-play')?.addEventListener('click', playPattern);
    rhythmNext?.addEventListener('click', newPattern);
    rhythmAnswers.forEach((button) => button.addEventListener('click', () => {
      if (!currentPattern || button.disabled) return;
      rhythmAttempts += 1;
      const correct = button.dataset.rhythmAnswer === currentPattern.id;
      if (correct) rhythmCorrect += 1;
      rhythmScore.textContent = `Aciertos: ${rhythmCorrect} de ${rhythmAttempts}`;
      rhythmFeedback.textContent = correct
        ? `¡Eso! Era un patrón de ${currentPattern.name}.`
        : `Era un patrón de ${currentPattern.name}. Escucha otra vez en el siguiente reto.`;
      button.classList.add(correct ? 'border-neon' : 'border-red-500', correct ? 'text-[var(--accent)]' : 'text-red-400');
      rhythmAnswers.forEach((answer) => { answer.disabled = true; });
      rhythmNext.classList.remove('hidden');
    }));
    newPattern();
  })();
</script>
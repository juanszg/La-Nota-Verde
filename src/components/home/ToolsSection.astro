    const renderNinths = () => {
      list.innerHTML = ninths.map(([name, root, shape, frets]) => `<div class="chord-cheatsheet-card rounded-xl border border-[var(--border)] bg-black/15 p-3" style="--chord-color:${({C:'#72ff9b','C♯':'#c4ff6b',D:'#ffcc66','D♯':'#ff8f70',E:'#ff6f91',F:'#d78cff','F♯':'#8f9dff',G:'#6edbff','G♯':'#63f0d1',A:'#b2f078','A♯':'#ffd166',B:'#ff9fbd'})[name.replace(/m?9$/,'')]||'#72ff9b'}"><div class="flex items-center justify-between"><b class="text-lg">${name}</b><span class="chord-root-label">${root}</span></div><div class="mt-2 flex gap-1">${frets.map(fret => `<span class="chord-fret-cell grid place-items-center rounded control-surface font-mono">${fret}</span>`).join('')}</div><p class="mt-1 font-mono text-[8px] text-[var(--text-muted)]">${shape}</p></div>`).join('');

---
const chords = [
  { name: 'A7', root: '5.ª cuerda', shape: 'x 0 2 0 2 0', frets: ['x','0','2','0','2','0'] },
  { name: 'Am7', root: '5.ª cuerda', shape: 'x 0 2 0 1 0', frets: ['x','0','2','0','1','0'] },
  { name: 'B7', root: '5.ª cuerda', shape: 'x 2 1 2 0 2', frets: ['x','2','1','2','0','2'] },
  { name: 'C7', root: '5.ª cuerda', shape: 'x 3 2 3 1 0', frets: ['x','3','2','3','1','0'] },
  { name: 'D7', root: '4.ª cuerda', shape: 'x x 0 2 1 2', frets: ['x','x','0','2','1','2'] },
  { name: 'Dm7', root: '4.ª cuerda', shape: 'x x 0 2 1 1', frets: ['x','x','0','2','1','1'] },
  { name: 'E7', root: '6.ª cuerda', shape: '0 2 0 1 0 0', frets: ['0','2','0','1','0','0'] },
  { name: 'Em7', root: '6.ª cuerda', shape: '0 2 0 0 0 0', frets: ['0','2','0','0','0','0'] },
  { name: 'F7', root: '6.ª cuerda', shape: '1 3 1 2 1 1', frets: ['1','3','1','2','1','1'] },
  { name: 'G7', root: '6.ª cuerda', shape: '3 2 0 0 0 1', frets: ['3','2','0','0','0','1'] },
  { name: 'Amaj7', root: '5.ª cuerda', shape: 'x 0 2 1 2 0', frets: ['x','0','2','1','2','0'] },
  { name: 'Bmaj7', root: '5.ª cuerda', shape: 'x 2 4 3 4 2', frets: ['x','2','4','3','4','2'] },
  { name: 'Cmaj7', root: '5.ª cuerda', shape: 'x 3 2 0 0 0', frets: ['x','3','2','0','0','0'] },
  { name: 'Dmaj7', root: '4.ª cuerda', shape: 'x x 0 2 2 2', frets: ['x','x','0','2','2','2'] },
  { name: 'Emaj7', root: '6.ª cuerda', shape: '0 2 1 1 0 0', frets: ['0','2','1','1','0','0'] },
  { name: 'Fmaj7', root: '6.ª cuerda', shape: '1 3 2 2 1 1', frets: ['1','3','2','2','1','1'] },
  { name: 'Gmaj7', root: '6.ª cuerda', shape: '3 2 0 0 0 2', frets: ['3','2','0','0','0','2'] },
];
const chordPalette = ['#72ff9b','#c4ff6b','#ffcc66','#ff8f70','#ff6f91','#d78cff','#8f9dff','#6edbff','#63f0d1','#b2f078','#ffd166','#ff9fbd'];
const chordColor = (name: string): string => {
  const pitchNames = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
  const root = name.match(/^[A-G](?:♯|♭)?/)?.[0] || 'C';
  const enharmonic: Record<string,string> = {'D♭':'C♯','E♭':'D♯','G♭':'F♯','A♭':'G♯','B♭':'A♯'};
  const normalized = enharmonic[root] || root;
  if (normalized === 'A') return '#ff7800';
  if (normalized === 'B') return '#f04458';
  if (normalized === 'C') return '#16db65';
  return chordPalette[pitchNames.indexOf(normalized)] || chordPalette[0];
};
---
<section id="herramientas" class="px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">01 / Afinador</span><span class="text-2xl">◉</span></div>
        <h3 class="mt-5 text-2xl font-bold">Clava la nota.</h3><p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Usa el micrófono para medir la afinación estándar de tu guitarra.</p>
        <div class="my-7 rounded-2xl border border-[var(--border)] bg-black/20 px-4 py-5 text-center"><div id="tuner-note" class="text-6xl font-bold text-[var(--accent)]">E</div><div id="tuner-status" class="mt-2 text-[10px] uppercase tracking-widest text-[var(--text-muted)]">Esperando señal</div><div class="relative mx-auto mt-5 h-1.5 max-w-48 rounded-full track-surface"><span class="absolute left-1/2 top-[-5px] h-4 w-px bg-[var(--text-muted)]"></span><span id="tuner-needle" class="absolute left-1/2 top-[-4px] h-3 w-1 rounded bg-neon transition-all"></span></div><div id="tuner-cents" class="mt-2 text-[10px] text-[var(--text-muted)]">0 cents</div></div>
        <button id="tuner-start" class="w-full rounded-xl bg-neon px-4 py-3 text-xs font-bold text-ink transition hover:bg-white">Activar micrófono</button>
        <p class="mt-3 text-center text-[9px] leading-4 text-[var(--text-muted)]">Afinación estándar · E A D G B E · requiere permiso del micrófono</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-start-2 lg:row-start-1">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">03 / Solfeo</span><span class="text-2xl">♫</span></div><h3 class="mt-5 text-2xl font-bold">Aprende la escala.</h3><p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">Toca cada nota y canta la escala. Do mayor, sin sostenidos ni bemoles.</p>
        <div class="mt-8 grid grid-cols-4 gap-2">{['Do','Re','Mi','Fa','Sol','La','Si','Do’'].map((note, i) => <button type="button" data-note={i} class="solfege-note glow-hover aspect-square rounded-xl border border-[var(--border)] control-surface text-lg font-bold transition hover:-translate-y-1 hover:border-neon hover:bg-neon/15 focus-visible:outline-2 focus-visible:outline-neon">{note}</button>)}</div>
        <div class="mt-5 flex flex-wrap gap-2"><button type="button" id="solfege-chromatic-toggle" class="music-control" aria-pressed="false">＋ Ver teclas con alteraciones</button><button type="button" id="solfege-notation-toggle" class="music-control" aria-pressed="false" hidden>Mostrar bemoles ♭</button></div>
        <div id="solfege-piano" class="solfege-piano mt-3 hidden" role="group" aria-label="Teclas cromáticas del piano"></div>
        <button id="solfege-play" class="mt-4 w-full rounded-xl border border-neon/30 px-4 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">▶ Escuchar escala</button><p id="solfege-hint" class="mt-3 min-h-8 text-center text-[9px] leading-4 text-[var(--text-muted)]">Elige una nota o escucha la escala completa.</p>
      </article>
      <article class="tool-card chord-cheatsheet-panel glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-span-2 lg:row-start-2">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">02 / Acordes</span><span class="text-2xl">⌁</span></div><div class="mt-5 flex flex-wrap items-center justify-between gap-3"><h3 id="chord-cheatsheet-title" class="text-2xl font-bold">Cheatsheet 7.ª.</h3><div class="chord-cheatsheet-controls"><label class="chord-note-filter-label" for="chord-note-filter">Nota a visualizar<select id="chord-note-filter" class="chord-note-filter"><option value="all">Todas</option><option value="C">C · Do</option><option value="D">D · Re</option><option value="E">E · Mi</option><option value="F">F · Fa</option><option value="G">G · Sol</option><option value="A">A · La</option><option value="B">B · Si</option></select></label><button id="chord-extension-toggle" type="button" class="rounded-xl border border-neon/40 px-4 py-2 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10 hover:shadow-[0_0_18px_rgb(99_245_140_/_0.2)]" aria-pressed="false">Ver acordes con 9.ª</button></div></div><p id="chord-cheatsheet-description" class="mt-2 text-xs leading-6 text-[var(--text-muted)]">Acordes esenciales con raíz en 4.ª, 5.ª y 6.ª cuerda. Cuerdas de 6.ª a 1.ª.</p>
        <div id="chord-cheatsheet-list" class="chord-cheatsheet-list mt-5 grid gap-3">{chords.map((chord) => <div role="button" tabindex="0" aria-label={`Ver detalles de ${chord.name}`} class="chord-cheatsheet-card rounded-xl border border-[var(--border)] bg-black/15 p-3" style={`--chord-color:${chordColor(chord.name)}`}><div class="flex items-center justify-between"><b class="text-lg">{chord.name}</b><span class="chord-root-label">{chord.root}</span></div><div class="mt-2 flex gap-1">{chord.frets.map((fret) => <span class="chord-fret-cell grid place-items-center rounded control-surface font-mono">{fret}</span>)}</div><p class="mt-1 font-mono text-[8px] text-[var(--text-muted)]">{chord.shape}</p></div>)}</div>
        <p class="mt-4 text-[9px] leading-4 text-[var(--text-muted)]">Números = traste · 0 = cuerda al aire · x = no tocar. Diagramas en orden 6.ª → 1.ª.</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">04 / Juego de oído</span><span class="text-2xl">耳</span></div>
        <h3 class="mt-5 text-2xl font-bold">¿Qué intervalo escuchas?</h3>
        <p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Escucha dos notas y reconoce la distancia entre ellas. Puedes repetir el ejemplo antes de responder.</p>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[var(--border)] bg-black/15 p-3"><span class="text-[10px] uppercase tracking-wider text-[var(--text-muted)]">Puntuación</span><strong id="ear-score" class="text-xs text-[var(--accent)]" aria-live="polite">0 de 0</strong></div>
        <div class="mt-4 grid grid-cols-4 gap-2" role="group" aria-label="Elige el intervalo escuchado">
          <button type="button" data-ear-answer="1" aria-label="Segunda menor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">2ª m</button>
          <button type="button" data-ear-answer="2" aria-label="Segunda mayor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">2ª M</button>
          <button type="button" data-ear-answer="3" aria-label="Tercera menor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">3ª m</button>
          <button type="button" data-ear-answer="4" aria-label="Tercera mayor" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">3ª M</button>
          <button type="button" data-ear-answer="5" aria-label="Cuarta justa" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">4ª J</button>
          <button type="button" data-ear-answer="6" aria-label="Cuarta aumentada o quinta disminuida" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">4ª A</button>
          <button type="button" data-ear-answer="7" aria-label="Quinta justa" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">5ª J</button>
          <button type="button" data-ear-answer="12" aria-label="Octava justa" class="ear-answer rounded-lg border border-[var(--border)] control-surface px-2 py-3 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">8ª J</button>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2"><button type="button" id="ear-play" class="rounded-xl bg-neon px-3 py-3 text-xs font-bold text-ink transition hover:bg-white">▶ Escuchar</button><button type="button" id="ear-next" class="hidden rounded-xl border border-neon/30 px-3 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">Otro reto →</button></div>
        <p id="ear-feedback" class="mt-3 min-h-10 text-center text-[10px] leading-5 text-[var(--text-muted)]" aria-live="polite">Pulsa escuchar y elige la distancia entre las notas.</p>
      </article>

      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">05 / Reto de ritmo</span><span class="text-2xl">♩</span></div>
        <h3 class="mt-5 text-2xl font-bold">Escucha el patrón.</h3>
        <p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Sigue el pulso grave y reconoce el ritmo de los golpes agudos en 4/4.</p>
        <label for="rhythm-tempo" class="mt-5 flex items-center justify-between text-[10px] uppercase tracking-wider text-[var(--text-muted)]"><span>Tempo</span><strong id="rhythm-tempo-label" class="text-[var(--accent)]">84 BPM</strong></label>
        <input id="rhythm-tempo" class="mt-3 w-full accent-[var(--accent)]" type="range" min="60" max="132" step="6" value="84" aria-label="Tempo del reto de ritmo" />
        <div class="mt-5 grid grid-cols-2 gap-2" role="group" aria-label="Elige el patrón rítmico">
          <button type="button" data-rhythm-answer="quarter" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Negras</button>
          <button type="button" data-rhythm-answer="eighth" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Corcheas</button>
          <button type="button" data-rhythm-answer="syncopated" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Síncopa</button>
          <button type="button" data-rhythm-answer="rests" class="rhythm-answer min-h-14 rounded-xl border border-[var(--border)] control-surface px-3 py-2 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">Con silencios</button>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2"><button type="button" id="rhythm-play" class="rounded-xl bg-neon px-3 py-3 text-xs font-bold text-ink transition hover:bg-white">▶ Escuchar ritmo</button><button type="button" id="rhythm-next" class="hidden rounded-xl border border-neon/30 px-3 py-3 text-xs font-bold text-[var(--accent)] transition hover:bg-neon/10">Nuevo ritmo →</button></div>
        <p id="rhythm-feedback" class="mt-3 min-h-10 text-center text-[10px] leading-5 text-[var(--text-muted)]" aria-live="polite">Escucha las veces que necesites y luego elige una opción.</p>
        <p id="rhythm-score" class="text-center text-[9px] text-[var(--text-muted)]" aria-live="polite">Aciertos: 0 de 0</p>
      </article>
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7">
        <div class="flex items-center justify-between"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">06 / Metrónomo</span><span class="text-2xl">⏱</span></div>
        <h3 class="mt-5 text-2xl font-bold">Encuentra tu pulso.</h3>
        <p class="mt-2 min-h-12 text-xs leading-6 text-[var(--text-muted)]">Ajusta el tempo y el compás. El primer pulso de cada compás se marca con un acento.</p>
        <div class="mt-5 rounded-2xl border border-[var(--border)] bg-black/15 p-4">
          <div class="flex items-end justify-between gap-3"><label for="metro-bpm" class="text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]">Tempo</label><output id="metro-bpm-value" for="metro-bpm" class="font-display text-4xl font-bold text-[var(--accent)]">90 <small class="text-xs">BPM</small></output></div>
          <input id="metro-bpm" class="mt-3 w-full accent-[var(--accent)]" type="range" min="30" max="240" value="90" aria-label="Tempo del metrónomo en pulsos por minuto">
          <div class="mt-3 flex justify-between gap-2"><button type="button" id="metro-minus" class="metro-adjust">−5</button><button type="button" id="metro-tap" class="metro-adjust">Tap tempo</button><button type="button" id="metro-plus" class="metro-adjust">+5</button></div>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3"><label class="metro-label">Compás<select id="metro-meter" class="metro-select"><option value="2">2/4</option><option value="3">3/4</option><option value="4" selected>4/4</option><option value="6">6/8</option></select></label><label class="metro-label">Timbre<select id="metro-tone" class="metro-select"><option value="wood">Madera</option><option value="digital">Digital</option><option value="bell">Campana</option></select></label></div>
        <div id="metro-beats" class="mt-5 flex min-h-12 items-center justify-center gap-3" aria-label="Indicador de pulso"></div>
        <button type="button" id="metro-toggle" class="mt-3 w-full rounded-xl bg-neon px-4 py-3 text-xs font-bold text-ink transition hover:bg-white" aria-pressed="false">▶ Iniciar metrónomo</button>
      </article>
      <article class="tool-card glow-hover surface rounded-3xl p-6 sm:p-7 lg:col-span-2">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="flex items-center gap-3"><span class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">06 / Escalas</span><span class="text-2xl">♬</span></div>
            <h3 class="mt-4 text-2xl font-bold">Explora el diapasón.</h3>
            <p class="mt-2 max-w-2xl text-xs leading-6 text-[var(--text-muted)]">Visualiza notas y patrones en cada cuerda, cambia la tonalidad y compara escalas mayores, menores y pentatónicas.</p>
            <div class="mt-4 flex flex-wrap gap-2 text-[9px]">
              <span class="rounded-full border border-[var(--border)] px-3 py-1.5 text-[var(--text-muted)]">Menor natural</span>
              <span class="rounded-full border border-[var(--border)] px-3 py-1.5 text-[var(--text-muted)]">Menor armónica</span>
              <span class="rounded-full border border-[var(--border)] px-3 py-1.5 text-[var(--text-muted)]">Menor melódica</span>
              <span class="rounded-full border border-[var(--border)] px-3 py-1.5 text-[var(--text-muted)]">Pentatónicas</span>
            </div>
          </div>
          <a href="/guitarra/diapason" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-neon px-5 py-3 text-xs font-bold text-ink transition hover:bg-white">Abrir diapasón →</a>
        </div>
      </article>
    </div>
  </div>
</section>
<dialog id="chord-detail-dialog" class="chord-detail-dialog"><button id="chord-dialog-prev" class="chord-dialog-nav chord-dialog-prev" type="button" aria-label="Acorde anterior">‹</button><button id="chord-dialog-next" class="chord-dialog-nav chord-dialog-next" type="button" aria-label="Acorde siguiente">›</button><button id="chord-dialog-theme" class="chord-dialog-theme" type="button" aria-label="Cambiar tema">☀</button><button id="chord-dialog-close" class="chord-dialog-close" type="button" aria-label="Cerrar">×</button><p class="text-xs uppercase tracking-[.18em] text-[var(--accent)]">Acorde · diagrama · análisis</p><h2 id="chord-dialog-title"></h2><p class="chord-dialog-key-hint">Usa ← y → para cambiar de acorde</p><div class="chord-dialog-grid"><div><h3>Tablatura · 6.ª a 1.ª cuerda</h3><div id="chord-dialog-tab" class="chord-dialog-tab"></div><div id="chord-dialog-board" class="chord-dialog-board" aria-label="Diagrama de guitarra"></div></div><div><h3>Notas e intervalos</h3><ul id="chord-dialog-notes"></ul></div></div><div class="chord-dialog-audio"><button id="chord-dialog-play" class="chord-dialog-play" type="button">▶ Escuchar acorde</button><button id="chord-dialog-arpeggio" class="chord-dialog-play chord-dialog-play-alt" type="button">♫ Escuchar arpegiado</button></div></dialog>
<script is:inline>
  (() => {
    const sharpNames=['Do','Do♯','Re','Re♯','Mi','Fa','Fa♯','Sol','Sol♯','La','La♯','Si'];
    const flatNames=['Do','Re♭','Re','Mi♭','Mi','Fa','Sol♭','Sol','La♭','La','Si♭','Si'];
    window.playPianoNote=(frequency)=>{const ctx=new AudioContext();if(ctx.state==='suspended')ctx.resume();const master=ctx.createGain();master.gain.setValueAtTime(.0001,ctx.currentTime);master.gain.exponentialRampToValueAtTime(.2,ctx.currentTime+.008);master.gain.setValueAtTime(.16,ctx.currentTime+1);master.gain.exponentialRampToValueAtTime(.0001,ctx.currentTime+2);master.connect(ctx.destination);[1,2,3,4,5].forEach((partial,i)=>{const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type='sine';osc.frequency.value=frequency*partial;gain.gain.value=[1,.34,.16,.08,.035][i];osc.connect(gain).connect(master);osc.start();osc.stop(ctx.currentTime+2.05);});setTimeout(()=>ctx.close(),2300);};
    window.playPianoChord=(frequencies,arpeggio=false,onNote=()=>{})=>{const ctx=new AudioContext(),start=ctx.currentTime,gap=arpeggio ? .24 : .035,duration=arpeggio ? 1.8 : 2.2;frequencies.forEach((frequency,index)=>{const onset=start+index*gap;setTimeout(()=>onNote(index),index*gap*1000);[1,2,3,4,5].forEach((partial,i)=>{const osc=ctx.createOscillator(),gain=ctx.createGain();osc.type='sine';osc.frequency.value=frequency*partial;gain.gain.setValueAtTime(.0001,onset);gain.gain.exponentialRampToValueAtTime([.22,.075,.04,.022,.012][i],onset+.01);gain.gain.exponentialRampToValueAtTime(.0001,onset+duration);osc.connect(gain).connect(ctx.destination);osc.start(onset);osc.stop(onset+duration+.05);});});setTimeout(()=>ctx.close(),(duration+frequencies.length*gap+.2)*1000);};
    const panel=document.querySelector('#solfege-piano'), reveal=document.querySelector('#solfege-chromatic-toggle'), spelling=document.querySelector('#solfege-notation-toggle');
    let flats=false;
    const drawPiano=()=>{ if(!panel)return; const names=flats?flatNames:sharpNames; panel.innerHTML=names.map((name,i)=>`<button type="button" class="piano-key ${[1,3,6,8,10].includes(i)?'is-black':''} ${[0,2,4,5,7,9,11].includes(i)?'is-scale-note':''}" data-pitch="${i}" aria-label="${name}">${name}</button>`).join(''); panel.querySelectorAll('.piano-key').forEach(key=>key.addEventListener('click',()=>{window.playPianoNote(261.63*Math.pow(2,Number(key.dataset.pitch)/12));document.querySelector('#solfege-hint').textContent=`${names[Number(key.dataset.pitch)]} · piano`;})); };
    reveal?.addEventListener('click',()=>{const active=reveal.getAttribute('aria-pressed')!=='true';reveal.setAttribute('aria-pressed',String(active));panel?.classList.toggle('hidden',!active);spelling.hidden=!active;reveal.textContent=active?'− Ocultar teclas con alteraciones':'＋ Ver teclas con alteraciones';});
    spelling?.addEventListener('click',()=>{flats=!flats;spelling.setAttribute('aria-pressed',String(flats));spelling.textContent=flats?'Mostrar sostenidos ♯':'Mostrar bemoles ♭';drawPiano();});
    const colors=['#63b8ff','#ffad66','#c995ff'];
    document.querySelectorAll('.tool-card h3').forEach((title,index)=>{const words=title.textContent.trim().split(/\s+/);if(words.length<2)return;title.textContent='';title.classList.add('tool-typewriter');words.forEach((word,i)=>{const part=document.createElement('span');part.textContent=word;part.className=i===1?'tool-title-accent':'';if(i===1)part.style.setProperty('--title-accent',colors[index%colors.length]);title.append(part);if(i<words.length-1)title.append(' ');});});
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-typing');observer.unobserve(entry.target);}}),{threshold:.45});
    document.querySelectorAll('.tool-typewriter').forEach(title=>observer.observe(title));
  })();
</script>
<script is:inline>
  (() => {
    const bpm = document.querySelector('#metro-bpm');
    const toggle = document.querySelector('#metro-toggle');
    const meter = document.querySelector('#metro-meter');
    const tone = document.querySelector('#metro-tone');
    const beats = document.querySelector('#metro-beats');
    if (!bpm || !toggle || !meter || !tone || !beats) return;
    let context, timer = 0, beat = 0, tapTimes = [];
    const updateBpm = () => { document.querySelector('#metro-bpm-value').innerHTML = `${bpm.value} <small class="text-xs">BPM</small>`; };
    const drawBeats = () => { beats.innerHTML = Array.from({length:Number(meter.value)},(_,i)=>`<span class="metro-beat ${i===beat?'is-current':''} ${i===0?'is-accent':''}" aria-hidden="true"></span>`).join(''); };
    const tick = () => {
      const now = context.currentTime;
      const accent = beat === 0;
      const osc = context.createOscillator(), gain = context.createGain();
      osc.type = tone.value === 'digital' ? 'square' : tone.value === 'bell' ? 'sine' : 'triangle';
      osc.frequency.value = tone.value === 'bell' ? (accent ? 1320 : 990) : tone.value === 'wood' ? (accent ? 880 : 620) : (accent ? 1100 : 760);
      gain.gain.setValueAtTime(.0001,now); gain.gain.exponentialRampToValueAtTime(accent ? .22 : .14,now+.004); gain.gain.exponentialRampToValueAtTime(.0001,now+(tone.value === 'bell' ? .22 : .075));
      osc.connect(gain).connect(context.destination); osc.start(now); osc.stop(now+(tone.value === 'bell' ? .24 : .08));
      drawBeats(); beat=(beat+1)%Number(meter.value);
    };
    const start = async () => { context ||= new AudioContext(); if(context.state==='suspended') await context.resume(); beat=0; tick(); timer=window.setInterval(tick,60000/Number(bpm.value)); toggle.textContent='■ Detener metrónomo'; toggle.setAttribute('aria-pressed','true'); };
    const stop = () => { clearInterval(timer); timer=0; beat=0; toggle.textContent='▶ Iniciar metrónomo'; toggle.setAttribute('aria-pressed','false'); drawBeats(); };
    bpm.addEventListener('input',()=>{updateBpm();if(timer){clearInterval(timer);timer=window.setInterval(tick,60000/Number(bpm.value));}});
    document.querySelector('#metro-minus').addEventListener('click',()=>{bpm.value=Math.max(30,Number(bpm.value)-5);bpm.dispatchEvent(new Event('input'));});
    document.querySelector('#metro-plus').addEventListener('click',()=>{bpm.value=Math.min(240,Number(bpm.value)+5);bpm.dispatchEvent(new Event('input'));});
    document.querySelector('#metro-tap').addEventListener('click',()=>{const now=Date.now();tapTimes=[...tapTimes.filter(t=>now-t<2500),now].slice(-5);if(tapTimes.length>1){const gaps=tapTimes.slice(1).map((t,i)=>t-tapTimes[i]);bpm.value=Math.max(30,Math.min(240,Math.round(60000/(gaps.reduce((a,b)=>a+b,0)/gaps.length))));bpm.dispatchEvent(new Event('input'));}});
    meter.addEventListener('change',()=>{beat=0;drawBeats();if(timer){clearInterval(timer);timer=window.setInterval(tick,60000/Number(bpm.value));}});
    toggle.addEventListener('click',()=>timer?stop():start()); drawBeats(); updateBpm();
  })();
</script>
<script is:inline>
  const noteNames = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
  let audioContext, stream, analyser, micBuffer;
  const tunerButton = document.querySelector('#tuner-start');
  tunerButton?.addEventListener('click', async () => {
    if (stream) { stream.getTracks().forEach(track => track.stop()); stream = null; tunerButton.textContent='Activar micrófono'; document.querySelector('#tuner-status').textContent='Micrófono pausado'; return; }
    try { stream = await navigator.mediaDevices.getUserMedia({audio:true}); audioContext = new AudioContext(); analyser = audioContext.createAnalyser(); analyser.fftSize=4096; audioContext.createMediaStreamSource(stream).connect(analyser); micBuffer=new Float32Array(analyser.fftSize); tunerButton.textContent='Pausar afinador'; document.querySelector('#tuner-status').textContent='Escuchando…'; detectPitch(); }
    catch { document.querySelector('#tuner-status').textContent='No se pudo acceder al micrófono'; }
  });
  function detectPitch(){ if(!stream)return; analyser.getFloatTimeDomainData(micBuffer); let rms=Math.sqrt(micBuffer.reduce((sum,v)=>sum+v*v,0)/micBuffer.length); if(rms>.012){let best=-1,score=0; for(let lag=35;lag<micBuffer.length/2;lag++){let s=0;for(let i=0;i<micBuffer.length/2;i++)s+=micBuffer[i]*micBuffer[i+lag];if(s>score){score=s;best=lag;}} if(best>0){let hz=audioContext.sampleRate/best;let midi=Math.round(69+12*Math.log2(hz/440));let target=440*Math.pow(2,(midi-69)/12);let cents=Math.round(1200*Math.log2(hz/target));let name=noteNames[(midi%12+12)%12];document.querySelector('#tuner-note').textContent=name;document.querySelector('#tuner-cents').textContent=`${cents>0?'+':''}${cents} cents`;document.querySelector('#tuner-status').textContent=cents===0?'Afinada':cents<0?'Sube la afinación':'Baja la afinación';document.querySelector('#tuner-needle').style.transform=`translateX(${Math.max(-45,Math.min(45,cents*1.5))}px)`;}} requestAnimationFrame(detectPitch); }
  const solfegeFreq=[261.63,293.66,329.63,349.23,392,440,493.88,523.25];
  function playSolfege(index){if(!window.AudioContext)return;window.playPianoNote?.(solfegeFreq[index]);document.querySelector('#solfege-hint').textContent=`${['Do','Re','Mi','Fa','Sol','La','Si','Do’'][index]} · piano`;}
  document.querySelectorAll('.solfege-note').forEach(button=>button.addEventListener('click',()=>playSolfege(Number(button.dataset.note))));
  document.querySelector('#solfege-play')?.addEventListener('click',()=>{[0,1,2,3,4,5,6,7].forEach((n,i)=>setTimeout(()=>playSolfege(n),i*570));});
</script>


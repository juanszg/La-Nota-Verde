const chords = [
  { name: 'A7', root: '5.ª cuerda', shape: 'x 0 2 0 2 0', frets: ['x','0','2','0','2','0'] },
  { name: 'Am7', root: '5.ª cuerda', shape: 'x 0 2 0 1 0', frets: ['x','0','2','0','1','0'] },
  { name: 'B7', root: '5.ª cuerda', shape: 'x 2 1 2 0 2', frets: ['x','2','1','2','0','2'] },
  { name: 'C7', root: '5.ª cuerda', shape: 'x 3 2 3 1 0', frets: ['x','3','2','3','1','0'] },
  { name: 'D7', root: '4.ª cuerda', shape: 'x x 0 2 1 2', frets: ['x','x','0','2','1','2'] },
  { name: 'Dm7', root: '4.ª cuerda', shape: 'x x 0 2 1 1', frets: ['x','x','0','2','1','1'] },
  { name: 'E7', root: '6.ª cuerda', shape: '0 2 0 1 0 0', frets: ['0','2','0','1','0','0'] },
  { name: 'Em7', root: '6.ª cuerda', shape: '0 2 0 0 0 0', frets: ['0','2','0','0','0','0'] },
  { name: 'F7', root: '6.ª cuerda', shape: '1 3 1 2 1 1', frets: ['1','3','1','2','1','1'] },
  { name: 'G7', root: '6.ª cuerda', shape: '3 2 0 0 0 1', frets: ['3','2','0','0','0','1'] },
  { name: 'Amaj7', root: '5.ª cuerda', shape: 'x 0 2 1 2 0', frets: ['x','0','2','1','2','0'] },
  { name: 'Bmaj7', root: '5.ª cuerda', shape: 'x 2 4 3 4 2', frets: ['x','2','4','3','4','2'] },
  { name: 'Cmaj7', root: '5.ª cuerda', shape: 'x 3 2 0 0 0', frets: ['x','3','2','0','0','0'] },
  { name: 'Dmaj7', root: '4.ª cuerda', shape: 'x x 0 2 2 2', frets: ['x','x','0','2','2','2'] },
  { name: 'Emaj7', root: '6.ª cuerda', shape: '0 2 1 1 0 0', frets: ['0','2','1','1','0','0'] },
  { name: 'Fmaj7', root: '6.ª cuerda', shape: '1 3 2 2 1 1', frets: ['1','3','2','2','1','1'] },
  { name: 'Gmaj7', root: '6.ª cuerda', shape: '3 2 0 0 0 2', frets: ['3','2','0','0','0','2'] },
];
const chordPalette = ['#72ff9b','#c4ff6b','#ffcc66','#ff8f70','#ff6f91','#d78cff','#8f9dff','#6edbff','#63f0d1','#b2f078','#ffd166','#ff9fbd'];
const chordColor = (name: string): string => {
  const pitchNames = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
  const root = name.match(/^[A-G](?:♯|♭)?/)?.[0] || 'C';
  const enharmonic: Record<string,string> = {'D♭':'C♯','E♭':'D♯','G♭':'F♯','A♭':'G♯','B♭':'A♯'};
  const normalized = enharmonic[root] || root;
  return chordPalette[pitchNames.indexOf(normalized)] || chordPalette[0];
};

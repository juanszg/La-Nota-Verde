    const intervalColors=['#16c26a','#12b8d6','#12b8d6','#ff4f9a','#ff4f9a','#ff8a3d','#ff8a3d','#7c4dff','#ff4f9a','#ff4f9a','#ffc21a','#ffc21a'];
    const intervalInk=['#04170c','#031a20','#031a20','#2a0314','#2a0314','#2a1200','#2a1200','#fff','#2a0314','#2a0314','#2a1c00','#2a1c00'];
    const drawFretboard=()=>{const rows=[...notes.querySelectorAll('li')],frets=[...tab.children].map(c=>c.querySelector('b')?.textContent||'x'),degreeLabels=['1','♭9','9','♭3','3','11','#11','5','♭13','13','♭7','7'];rows.forEach((row,index)=>{const string=Number(row.textContent.match(/Cuerda\s+(\d+)/)?.[1]),pc=pitchMap[row.querySelector('strong')?.textContent]??0,root=pitchMap[title.textContent.match(/^[A-G](?:♯|♭)?/)?.[0]]??0,iv=(pc-root+12)%12;row.dataset.string=string;row.style.setProperty('--interval-color',intervalColors[iv]);row.style.setProperty('--interval-ink',intervalInk[iv]);row.style.animationDelay=`${index*55}ms`;let degree=row.querySelector('b');if(!degree){degree=document.createElement('b');row.append(degree);}degree.textContent=degreeLabels[iv];});[...tab.children].forEach((cell,i)=>{const row=rows.find(r=>Number(r.dataset.string)===6-i);if(row){cell.style.setProperty('--cell-color',row.style.getPropertyValue('--interval-color'));cell.style.setProperty('--interval-color',row.style.getPropertyValue('--interval-color'));}});
      const positive=frets.map(Number).filter(n=>Number.isFinite(n)&&n>0),start=positive.length&&Math.max(...positive)>4?Math.min(...positive):1,rowsCount=Math.max(4,Math.max(...positive,4)-start+1),x0=32,dx=62,top=42,dy=52,width=380,height=top+rowsCount*dy+38;let svg=`<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Forma del acorde ${title.textContent} en el diapasón">`;
      for(let s=0;s<6;s++){const x=x0+s*dx;svg+=`<text class="chord-board-string" x="${x}" y="18" text-anchor="middle">${6-s}ª</text>`;}for(let f=0;f<=rowsCount;f++)svg+=`<line class="chord-board-line ${f===0&&start===1?'chord-board-nut':''}" x1="${x0}" x2="${x0+5*dx}" y1="${top+f*dy}" y2="${top+f*dy}"/>`;for(let s=0;s<6;s++)svg+=`<line class="chord-board-line" x1="${x0+s*dx}" x2="${x0+s*dx}" y1="${top}" y2="${top+rowsCount*dy}"/>`;
      if(start>1)svg+=`<text class="chord-board-fret" x="8" y="${top+dy*.65}">${start}</text>`;
      frets.forEach((f,i)=>{const string=6-i,x=x0+i*dx,row=rows.find(r=>Number(r.dataset.string)===string);if(f==='x')svg+=`<text class="chord-board-muted" x="${x}" y="${top-12}">×</text>`;else if(Number(f)===0)svg+=`<circle class="chord-board-open" cx="${x}" cy="${top-15}" r="6"/>`;else if(row){const y=top+(Number(f)-start+.5)*dy;svg+=`<g class="chord-fret-dot" data-string="${string}"><circle cx="${x}" cy="${y}" r="17" fill="${row.style.getPropertyValue('--interval-color')}"/><text x="${x}" y="${y+5}" text-anchor="middle" fill="${row.style.getPropertyValue('--interval-ink')}" font-size="13" font-weight="700">${row.querySelector('strong').textContent}</text></g>`;}});svg+='</svg>';document.querySelector('#chord-dialog-board').innerHTML=svg;};
    new MutationObserver(drawFretboard).observe(notes,{childList:true});
    new MutationObserver(()=>{title.classList.remove('swap');void title.offsetWidth;title.classList.add('swap');}).observe(title,{childList:true,characterData:true,subtree:true});
    const toggle = document.querySelector('#chord-extension-toggle');
    const list = document.querySelector('#chord-cheatsheet-list');
    const noteFilter=document.querySelector('#chord-note-filter');
    const applyChordNoteFilter=()=>{const selected=noteFilter?.value||'all',rootColors={A:'#ff7800',B:'#f04458',C:'#16db65'};[...list.querySelectorAll('.chord-cheatsheet-card')].forEach(card=>{const root=card.querySelector('b')?.textContent?.trim().match(/^[A-G](?:♯|♭)?/)?.[0]||'C',matches=selected==='all'||root===selected;if(rootColors[root])card.style.setProperty('--chord-color',rootColors[root]);card.classList.toggle('is-note-muted',selected!=='all'&&!matches);card.classList.toggle('is-note-focus',selected!=='all'&&matches);});};
    noteFilter?.addEventListener('change',applyChordNoteFilter);
    applyChordNoteFilter();
    if (!toggle || !list) return;
    const originalCards = list.innerHTML;
    const naturalRoots = [{note:'C',fret:3},{note:'D',fret:5},{note:'E',fret:7},{note:'F',fret:8},{note:'G',fret:10},{note:'A',fret:12},{note:'B',fret:2}];
    const ninths = naturalRoots.flatMap(({note,fret}) => {

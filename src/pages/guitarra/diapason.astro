---
import BaseLayout from '../../layouts/BaseLayout.astro';
const stringNames = ['6ª · E','5ª · A','4ª · D','3ª · G','2ª · B','1ª · E'];
const openMidi = [40,45,50,55,59,64];
const sharpNotes = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
const frets = Array.from({ length: 13 }, (_, index) => index);
const tuningButtons = [
  { id: 'standard', label: 'Estándar', tuning: 'E · A · D · G · B · E' },
  { id: 'drop-d', label: 'Drop D', tuning: 'D · A · D · G · B · E' },
  { id: 'open-g', label: 'Open G', tuning: 'D · G · D · G · B · D' },
  { id: 'dadgad', label: 'DADGAD', tuning: 'D · A · D · G · A · D' },
];
---
<BaseLayout title="Diapasón de guitarra — LA NOTA VERDE" description="Explora las notas, afinaciones y escalas en el diapasón interactivo de guitarra.">
  <main class="mx-auto max-w-[1500px] px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
    <a href="/aprender" class="inline-flex items-center gap-2 rounded-lg px-2 py-2 text-xs font-bold text-[var(--text-muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-neon">← Volver a Aprender</a>
    <header class="mt-5 flex flex-col gap-5 border-b border-[var(--border)] pb-7 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Playground de guitarra · La Nota Verde</p><h1 class="page-title mt-3 text-3xl font-bold sm:text-5xl">Diapasón interactivo</h1><p class="mt-3 max-w-2xl text-xs leading-6 text-[var(--text-muted)]">Encuentra notas, explora afinaciones, estudia escalas y escucha cada traste. En cifrado internacional: E = Mi y B = Si.</p></div>
      <div class="flex items-center gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface-raised)] px-4 py-3"><span class="grid h-10 w-10 place-items-center rounded-xl bg-neon/10 text-xl text-[var(--accent)]">♫</span><div><p class="text-[9px] uppercase tracking-widest text-[var(--text-muted)]">Nota seleccionada</p><p id="played-note" class="mt-1 text-sm font-bold">Toca cualquier traste</p></div></div>
    </header>

    <section class="mt-7 grid gap-5 xl:grid-cols-[minmax(0,1fr)_19rem]">
      <div class="min-w-0 space-y-5">
        <article class="surface rounded-2xl p-4 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">Afinación</p><p class="mt-1 text-[10px] text-[var(--text-muted)]">El diapasón se actualiza con cada afinación.</p></div><div class="flex flex-wrap gap-2" aria-label="Orientación y notación"><button type="button" id="handedness-toggle" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[10px] font-bold transition hover:border-neon hover:text-[var(--accent)]" aria-pressed="false">Mano derecha</button><button type="button" id="accidental-toggle" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[10px] font-bold transition hover:border-neon hover:text-[var(--accent)]" aria-pressed="false">♯ Sostenidos</button></div></div>
          <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">{tuningButtons.map((item) => <button type="button" data-tuning={item.id} aria-pressed={item.id === 'standard' ? 'true' : 'false'} class:list={["tuning-option rounded-xl border px-3 py-3 text-left transition hover:-translate-y-0.5", item.id === 'standard' ? 'is-active border-neon' : 'border-[var(--border)]']}><span class="block text-xs font-bold">{item.label}</span><span class="mt-1 block text-[8px] text-[var(--text-muted)]">{item.tuning}</span></button>)}</div>
        </article>

        <article class="surface min-w-0 rounded-2xl p-4 sm:p-6">
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">Notas en el diapasón</p><p class="mt-1 text-[10px] text-[var(--text-muted)]">Pulsa una nota para escucharla · el traste 12 marca la octava.</p></div><p class="text-[9px] text-[var(--text-muted)]">Afinación: <strong id="tuning-caption" class="text-[var(--text-primary)]">E · A · D · G · B · E</strong></p></div>
          <div class="fretboard-panel rounded-xl p-2 sm:p-3">
            <div class="fretboard-scroll" tabindex="0" aria-label="Diapasón. En móvil, desliza horizontalmente para recorrer los trastes.">
              <div id="fretboard" class="fretboard">
                <div class="fret-row fret-ruler"><span class="string-label">TRASTE</span>{frets.map((fret) => <span class:list={["fret-number", fret === 12 ? 'octave-number' : '']}>{fret}</span>)}</div>
                <div id="fretboard-strings" class="fretboard-strings">{stringNames.map((label, stringIndex) => <div class="fret-row guitar-string" data-string-index={stringIndex} data-open-midi={openMidi[stringIndex]}><span class="string-label">{label}</span>{frets.map((fret) => { const midi = openMidi[stringIndex] + fret; return <button type="button" data-fret={fret} data-midi={midi} data-pitch={midi % 12} aria-label={`${sharpNotes[midi % 12]}, ${label}, traste ${fret}`} class:list={["fret-note", fret === 0 ? 'open-note' : '', fret === 12 ? 'octave-fret' : '']}>{sharpNotes[midi % 12]}</button>; })}</div>)}</div>
              </div>
            </div>
            <p class="mt-3 text-center text-[9px] leading-4 text-white/55">Sexta cuerda (grave) arriba · primera cuerda (aguda) abajo</p>
          </div>
        </article>

        <article class="surface rounded-2xl p-4 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">Resalta notas</p><p class="mt-1 text-[10px] text-[var(--text-muted)]">Elige una o varias notas para ubicarlas por todo el diapasón.</p></div><div class="flex gap-2"><button type="button" id="show-all-notes" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[9px] font-bold hover:border-neon">Todas</button><button type="button" id="clear-notes" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[9px] font-bold hover:border-neon">Ninguna</button></div></div>
          <div id="note-filters" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-12">{sharpNotes.map((note, pitch) => <button type="button" data-pitch-filter={pitch} aria-pressed="false" class="note-filter rounded-lg border border-[var(--border)] control-surface py-2.5 text-xs font-bold transition hover:border-neon hover:text-[var(--accent)]">{note}</button>)}</div>
        </article>
      </div>

      <aside class="space-y-5">
        <article class="surface rounded-2xl p-4 sm:p-5">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">Visualiza una escala</p><p class="mt-1 text-[10px] leading-5 text-[var(--text-muted)]">Resalta sus notas y reconoce su patrón en el mástil.</p>
          <label for="scale-root" class="mt-4 block text-[9px] font-bold uppercase tracking-wider text-[var(--text-muted)]">Tonalidad</label><select id="scale-root" class="mt-2 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-2.5 text-xs text-[var(--text-primary)]"><option value="0">C</option><option value="1">C♯</option><option value="2">D</option><option value="3">D♯</option><option value="4">E</option><option value="5">F</option><option value="6">F♯</option><option value="7">G</option><option value="8">G♯</option><option value="9">A</option><option value="10">A♯</option><option value="11">B</option></select>
          <label for="scale-type" class="mt-4 block text-[9px] font-bold uppercase tracking-wider text-[var(--text-muted)]">Escala</label><select id="scale-type" class="mt-2 w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-2.5 text-xs text-[var(--text-primary)]"><option value="major">Mayor</option><option value="minor">Menor natural</option><option value="major-pentatonic">Pentatónica mayor</option><option value="minor-pentatonic">Pentatónica menor</option><option value="blues">Blues</option></select>
          <button type="button" id="show-scale" class="mt-4 w-full rounded-xl bg-neon px-4 py-3 text-xs font-bold text-ink transition hover:bg-white">Mostrar escala</button>
          <div class="mt-4 flex flex-wrap gap-3 text-[9px] text-[var(--text-muted)]"><span class="flex items-center gap-2"><i class="legend-dot root-dot"></i> Tónica</span><span class="flex items-center gap-2"><i class="legend-dot scale-dot"></i> Notas de escala</span></div>
        </article>
        <article class="rounded-2xl border border-neon/15 bg-neon/5 p-4 sm:p-5"><p class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">Cómo leerlo</p><ul class="mt-3 space-y-2 text-[10px] leading-5 text-[var(--text-muted)]"><li><strong class="text-[var(--text-primary)]">Cada traste</strong> sube un semitono.</li><li><strong class="text-[var(--text-primary)]">Traste 12</strong> repite la nota al aire una octava arriba.</li><li><strong class="text-[var(--text-primary)]">♯ / ♭</strong> cambia la escritura, no el sonido del traste.</li><li><strong class="text-[var(--text-primary)]">Afinaciones</strong> cambian la nota de cada cuerda al aire.</li></ul></article>
        <a href="/herramientas" class="block rounded-xl border border-[var(--border)] px-4 py-3 text-center text-[10px] font-bold text-[var(--text-muted)] transition hover:border-neon hover:text-[var(--accent)]">Ir a las herramientas musicales →</a>
      </aside>
    </section>
  </main>
</BaseLayout>

<style>
  .fretboard-panel { --accent: #63f58c; overflow: hidden; border: 1px solid rgb(99 245 140 / .22); background: linear-gradient(145deg, #0a1b11, #07100b 65%, #0d1b12); }
  .fretboard-scroll { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-color: #247844 #0a1710; }
  .fretboard { width: max-content; min-width: 100%; }
  .fret-row { display: grid; grid-template-columns: 4rem repeat(13, minmax(2.8rem, 3.25rem)); width: max-content; }
  .string-label, .fret-number { position: sticky; left: 0; z-index: 2; display: grid; place-items: center; background: #0a1710; color: #63f58c; font-family: 'Kode Mono', monospace; font-size: .62rem; font-weight: 700; }
  .fret-number { position: static; height: 2.2rem; border-right: 1px solid rgb(255 255 255 / .1); color: rgb(255 255 255 / .58); }
  .octave-number { background: rgb(99 245 140 / .15); color: #63f58c; }
  .guitar-string { position: relative; }
  .guitar-string::after { position: absolute; z-index: 0; top: 50%; left: 4rem; right: 0; height: 1px; content: ''; background: linear-gradient(90deg, rgb(213 220 207 / .5), rgb(213 220 207 / .25)); pointer-events: none; }
  .fret-note { position: relative; z-index: 1; display: grid; height: 3.2rem; place-items: center; border-right: 1px solid rgb(255 255 255 / .16); border-bottom: 1px solid rgb(255 255 255 / .08); color: rgb(255 255 255 / .62); font-family: 'Space Mono', monospace; font-size: .67rem; font-weight: 700; transition: color .18s, background .18s, transform .18s; }
  .fret-note:hover, .fret-note:focus-visible { z-index: 3; color: #07100b; background: #63f58c; outline: 2px solid #63f58c; outline-offset: -2px; }
  .fret-note.open-note { border-left: 3px solid #d5dccf; }
  .fret-note.octave-fret { background: rgb(255 255 255 / .045); }
  .fret-note.is-scale { color: #c4ffd4; background: rgb(99 245 140 / .18); }
  .fret-note.is-root { color: #07100b; background: #e5a553; box-shadow: 0 0 16px rgb(229 165 83 / .3); }
  .fret-note.is-filter-note { color: #07100b; background: #63f58c; }
  .fret-note.dim-note { color: rgb(255 255 255 / .18); }
  .tuning-option:focus-visible, .note-filter:focus-visible { outline: 2px solid #63f58c; outline-offset: 2px; }
  .fretboard.is-left-handed .fret-row { direction: rtl; }
  .fretboard.is-left-handed .fret-note, .fretboard.is-left-handed .string-label { direction: ltr; }
  .fretboard.is-left-handed .fretboard-strings { display: flex; flex-direction: column-reverse; }
  .fretboard.is-left-handed .guitar-string::after { left: 0; right: 4rem; }
  .tuning-option.is-active { border-color: #16db65; background: rgb(22 219 101 / .09); box-shadow: 0 0 18px rgb(22 219 101 / .08); }
  .note-filter.is-active { border-color: #16db65; color: #16db65; background: rgb(22 219 101 / .12); }
  .legend-dot { display: inline-block; width: .55rem; height: .55rem; border-radius: 50%; }
  .root-dot { background: #e5a553; }
  .scale-dot { background: #63f58c; }
  @media (max-width: 640px) { .fret-row { grid-template-columns: 3.5rem repeat(13, minmax(2.55rem, 2.8rem)); } .guitar-string::after { left: 3.5rem; } .fretboard.is-left-handed .guitar-string::after { left: 0; right: 3.5rem; } .fret-note { height: 3rem; font-size: .62rem; } }
  @media (prefers-reduced-motion: reduce) { .fret-note, .tuning-option { transition: none; } }
</style>

<script is:inline>
  (() => {
    const sharpNotes = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
    const flatNotes = ['C','D♭','D','E♭','E','F','G♭','G','A♭','A','B♭','B'];
    const openNotes = {
      standard: { midi: [40,45,50,55,59,64], name: 'E · A · D · G · B · E' },
      'drop-d': { midi: [38,45,50,55,59,64], name: 'D · A · D · G · B · E' },
      'open-g': { midi: [38,43,50,55,59,62], name: 'D · G · D · G · B · D' },
      dadgad: { midi: [38,45,50,55,57,62], name: 'D · A · D · G · A · D' },
    };
    const scaleSteps = {
      major: [0,2,4,5,7,9,11], minor: [0,2,3,5,7,8,10],
      'major-pentatonic': [0,2,4,7,9], 'minor-pentatonic': [0,3,5,7,10], blues: [0,3,5,6,7,10],
    };
    const fretboard = document.querySelector('#fretboard');
    const stringRows = [...document.querySelectorAll('.guitar-string')];
    const fretNotes = [...document.querySelectorAll('.fret-note')];
    const tuningCaption = document.querySelector('#tuning-caption');
    const playedNote = document.querySelector('#played-note');
    const noteFilters = [...document.querySelectorAll('.note-filter')];
    let useFlats = false;
    let highlightMode = 'all';
    let selectedPitchClasses = new Set();
    let scalePitchClasses = new Set();
    let audio;

    const currentNames = () => useFlats ? flatNotes : sharpNotes;
    const paintBoard = () => {
      const names = currentNames();
      stringRows.forEach((row, stringIndex) => {
        const openMidi = Number(row.dataset.openMidi);
        row.querySelector('.string-label').textContent = `${6 - stringIndex}ª · ${names[openMidi % 12]}`;
      });
      fretNotes.forEach((button) => {
        const row = button.closest('.guitar-string');
        const fret = Number(button.dataset.fret);
        const midi = Number(row.dataset.openMidi) + fret;
        const pitch = midi % 12;
        const name = names[pitch];
        button.dataset.midi = String(midi);
        button.dataset.pitch = String(pitch);
        button.textContent = name;
        button.setAttribute('aria-label', `${name}, cuerda ${6 - Number(row.dataset.stringIndex)}, traste ${fret}`);
        button.classList.toggle('is-scale', highlightMode === 'scale' && scalePitchClasses.has(pitch) && pitch !== Number(document.querySelector('#scale-root').value));
        button.classList.toggle('is-root', highlightMode === 'scale' && pitch === Number(document.querySelector('#scale-root').value));
        button.classList.toggle('is-filter-note', highlightMode === 'notes' && selectedPitchClasses.has(pitch));
        button.classList.toggle('dim-note', highlightMode === 'none');
      });
      noteFilters.forEach((button) => {
        button.textContent = names[Number(button.dataset.pitchFilter)];
        button.classList.toggle('is-active', highlightMode === 'notes' && selectedPitchClasses.has(Number(button.dataset.pitchFilter)));
        button.setAttribute('aria-pressed', String(highlightMode === 'notes' && selectedPitchClasses.has(Number(button.dataset.pitchFilter))));
      });
      document.querySelector('#scale-root').querySelectorAll('option').forEach((option) => { option.textContent = names[Number(option.value)]; });
    };

    document.querySelectorAll('[data-tuning]').forEach((button) => button.addEventListener('click', () => {
      const tuning = openNotes[button.dataset.tuning];
      if (!tuning) return;
      stringRows.forEach((row, index) => { row.dataset.openMidi = String(tuning.midi[index]); });
      tuningCaption.textContent = tuning.name;
      document.querySelectorAll('[data-tuning]').forEach((option) => {
        const active = option === button;
        option.classList.toggle('is-active', active);
        option.setAttribute('aria-pressed', String(active));
      });
      paintBoard();
    }));

    document.querySelector('#handedness-toggle').addEventListener('click', (event) => {
      const button = event.currentTarget;
      const left = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(left));
      button.textContent = left ? 'Mano izquierda' : 'Mano derecha';
      fretboard.classList.toggle('is-left-handed', left);
    });
    document.querySelector('#accidental-toggle').addEventListener('click', (event) => {
      useFlats = !useFlats;
      event.currentTarget.setAttribute('aria-pressed', String(useFlats));
      event.currentTarget.textContent = useFlats ? '♭ Bemoles' : '♯ Sostenidos';
      paintBoard();
    });

    const resetFilterState = () => { selectedPitchClasses = new Set(); scalePitchClasses = new Set(); };
    document.querySelector('#show-all-notes').addEventListener('click', () => { resetFilterState(); highlightMode = 'all'; paintBoard(); });
    document.querySelector('#clear-notes').addEventListener('click', () => { resetFilterState(); highlightMode = 'none'; paintBoard(); });
    noteFilters.forEach((button) => button.addEventListener('click', () => {
      const pitch = Number(button.dataset.pitchFilter);
      if (highlightMode !== 'notes') { selectedPitchClasses = new Set(); highlightMode = 'notes'; }
      if (selectedPitchClasses.has(pitch)) selectedPitchClasses.delete(pitch); else selectedPitchClasses.add(pitch);
      paintBoard();
    }));
    document.querySelector('#show-scale').addEventListener('click', () => {
      const root = Number(document.querySelector('#scale-root').value);
      const steps = scaleSteps[document.querySelector('#scale-type').value] || scaleSteps.major;
      scalePitchClasses = new Set(steps.map((step) => (root + step) % 12));
      selectedPitchClasses = new Set();
      highlightMode = 'scale';
      paintBoard();
    });

    fretNotes.forEach((button) => button.addEventListener('click', async () => {
      if (!window.AudioContext) { playedNote.textContent = 'Audio no disponible en este navegador'; return; }
      audio ??= new AudioContext();
      await audio.resume();
      const midi = Number(button.dataset.midi);
      const frequency = 440 * 2 ** ((midi - 69) / 12);
      const start = audio.currentTime + 0.015;
      const oscillator = audio.createOscillator();
      const overtone = audio.createOscillator();
      const filter = audio.createBiquadFilter();
      const gain = audio.createGain();
      oscillator.type = 'triangle'; overtone.type = 'sine';
      oscillator.frequency.setValueAtTime(frequency, start);
      overtone.frequency.setValueAtTime(frequency * 2.01, start);
      filter.type = 'lowpass'; filter.frequency.setValueAtTime(2600, start);
      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.exponentialRampToValueAtTime(0.16, start + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + 1.05);
      oscillator.connect(filter); overtone.connect(filter); filter.connect(gain).connect(audio.destination);
      oscillator.start(start); overtone.start(start); oscillator.stop(start + 1.08); overtone.stop(start + 1.08);
      playedNote.textContent = `${button.textContent} · ${frequency.toFixed(1)} Hz`;
    }));
    paintBoard();
  })();
</script>

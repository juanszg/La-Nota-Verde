---
import BaseLayout from '../../layouts/BaseLayout.astro';
const stringNames = ['1ª · E','2ª · B','3ª · G','4ª · D','5ª · A','6ª · E'];
const openMidi = [64,59,55,50,45,40];
const sharpNotes = ['C','C♯','D','D♯','E','F','F♯','G','G♯','A','A♯','B'];
const frets = Array.from({ length: 13 }, (_, index) => index);
const tuningButtons = [
  { id: 'standard', label: 'Estándar', tuning: 'E · B · G · D · A · E' },
  { id: 'drop-d', label: 'Drop D', tuning: 'E · B · G · D · A · D' },
  { id: 'open-g', label: 'Open G', tuning: 'D · B · G · D · G · D' },
  { id: 'dadgad', label: 'DADGAD', tuning: 'D · A · G · D · A · D' },
];
---
<BaseLayout title="Diapasón de guitarra — LA NOTA VERDE" description="Explora las notas, afinaciones y escalas en el diapasón interactivo de guitarra.">
  <main class="mx-auto max-w-[1500px] px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
    <a href="/aprender" class="inline-flex items-center gap-2 rounded-lg px-2 py-2 text-xs font-bold text-[var(--text-muted)] transition hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-neon">← Volver a Aprender</a>
    <header class="mt-5 flex flex-col gap-5 border-b border-[var(--border)] pb-7 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Playground de guitarra · La Nota Verde</p><h1 class="page-title mt-3 text-3xl font-bold sm:text-5xl">Diapasón interactivo</h1><p class="guitar-section-copy mt-3 max-w-2xl leading-6">Encuentra notas, explora afinaciones, estudia escalas y escucha cada traste. En cifrado internacional: E = Mi y B = Si.</p></div>
      <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface-raised)] px-4 py-3"><span class="grid h-10 w-10 place-items-center rounded-xl bg-neon/10 text-xl text-[var(--accent)]">♫</span><div><p class="text-[9px] uppercase tracking-widest text-[var(--text-muted)]">Nota seleccionada</p><p id="played-note" class="mt-1 text-sm font-bold">Toca cualquier traste</p></div><label for="note-tone" class="guitar-select-label">Timbre<select id="note-tone" class="guitar-select"><option value="default">Default</option><option value="electric">Eléctrica suave</option><option value="acoustic">Acústica</option></select></label></div>
    </header>

    <section class="mt-7 grid gap-5 xl:grid-cols-[minmax(0,1fr)_19rem]">
      <div class="min-w-0 space-y-5">
        <article class="surface rounded-2xl p-4 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3"><div><div class="flex flex-wrap items-center gap-3"><p class="guitar-section-title">Resalta notas</p><span id="active-scale-label" class="scale-context">Escala activa: ninguna</span></div><p class="guitar-section-copy mt-1">Elige tonalidad y escala aquí; las etiquetas muestran el intervalo desde la tónica.</p></div><div class="flex gap-2"><button type="button" id="show-all-notes" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[9px] font-bold hover:border-neon">Todas</button><button type="button" id="clear-notes" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[9px] font-bold hover:border-neon">Ninguna</button></div></div>
          <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(8rem,.7fr)_minmax(12rem,1.3fr)]">
            <label class="guitar-select-label">Tonalidad<select id="scale-root" class="guitar-select"><option value="0">C</option><option value="1">C♯</option><option value="2">D</option><option value="3">D♯</option><option value="4">E</option><option value="5">F</option><option value="6">F♯</option><option value="7">G</option><option value="8">G♯</option><option value="9">A</option><option value="10">A♯</option><option value="11">B</option></select></label>
            <label class="guitar-select-label">Escala<select id="scale-type" class="guitar-select"><option value="major">Mayor</option><option value="minor">Menor natural (eólica)</option><option value="harmonic-minor">Menor armónica</option><option value="melodic-minor">Menor melódica</option><option value="major-pentatonic">Pentatónica mayor</option><option value="minor-pentatonic">Pentatónica menor</option><option value="blues">Blues menor</option></select></label>
          </div>
          <button type="button" id="show-scale" class="mt-3 w-full rounded-xl bg-neon px-4 py-3 text-xs font-bold text-ink transition hover:bg-white">Aplicar escala e intervalos</button>
          <div id="scale-degree-legend" class="mt-4 flex flex-wrap gap-x-3 gap-y-2 text-[9px] text-[var(--text-muted)]" aria-live="polite"><span class="flex items-center gap-2"><i class="legend-dot degree-1"></i> I · Tónica</span></div>
          <div id="note-filters" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-12">{sharpNotes.map((note, pitch) => <button type="button" data-pitch-filter={pitch} aria-pressed="false" class="note-filter control-surface grid min-h-14 grid-rows-[auto_auto] place-items-center gap-0.5 rounded-lg border border-[var(--border)] py-2 transition hover:border-neon hover:text-[var(--accent)]"><span class="note-filter-name text-xs font-bold">{note}</span><small class="note-filter-interval text-[8px] font-medium text-[var(--text-muted)]">—</small></button>)}</div>
        </article>

        

        <article class="surface min-w-0 rounded-2xl p-4 sm:p-6">
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3"><div><p class="guitar-section-title">Notas en el diapasón</p><p class="guitar-section-copy mt-1">Pulsa una nota para escucharla · el traste 12 marca la octava.</p></div><p class="guitar-section-copy">Afinación: <strong id="tuning-caption" class="text-[var(--text-primary)]">E · B · G · D · A · E</strong></p></div>
          <div class="fretboard-panel rounded-xl p-2 sm:p-3"><button id="fretboard-fullscreen" type="button" class="fullscreen-button" aria-label="Expandir diapasón a pantalla completa" title="Pantalla completa"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3"/></svg></button>
            <section id="zen-header" class="zen-header" aria-hidden="true">
              <div class="zen-topline"><div><p class="zen-kicker">MODO ZEN · ESTUDIO DE ESCALA</p><h2 id="zen-scale-title" class="zen-scale-title">Elige una escala para comenzar</h2></div><div class="zen-zoom-control" role="group" aria-label="Escala visual del diapasón"><span>Escalado</span><div class="zen-zoom-options"><button type="button" data-zen-zoom="1.1" aria-pressed="false">10%</button><button type="button" data-zen-zoom="1.15" aria-pressed="false">15%</button><button type="button" data-zen-zoom="1.2" class="is-active" aria-pressed="true">20%</button><button type="button" data-zen-zoom="1.25" aria-pressed="false">25%</button></div></div></div>
              <div id="zen-scale-notes" class="zen-scale-notes"><span class="zen-empty">Aplica una escala para ver sus notas e intervalos.</span></div>
            </section>
            <div class="fretboard-scroll" tabindex="0" aria-label="Diapasón. En móvil, desliza horizontalmente para recorrer los trastes.">
              <div id="fretboard" class="fretboard">
                <div class="fret-row fret-ruler"><span class="string-label">TRASTE</span>{frets.map((fret) => <span class:list={["fret-number", fret === 12 ? 'octave-number' : '']}>{fret}</span>)}</div>
                <div id="fretboard-strings" class="fretboard-strings">{stringNames.map((label, stringIndex) => <div class="fret-row guitar-string" data-string-index={stringIndex} data-open-midi={openMidi[stringIndex]}><span class="string-label">{label}</span>{frets.map((fret) => { const midi = openMidi[stringIndex] + fret; return <button type="button" data-fret={fret} data-midi={midi} data-pitch={midi % 12} aria-label={`${sharpNotes[midi % 12]}, ${label}, traste ${fret}`} class:list={["fret-note", fret === 0 ? 'open-note' : '', fret === 12 ? 'octave-fret' : '']}><span class="fret-note-name">{sharpNotes[midi % 12]}</span><small class="fret-note-interval" aria-hidden="true"></small></button>; })}</div>)}</div>
              </div>
            </div>
            <p class="mt-3 text-center text-[9px] leading-4 text-white/55">Primera cuerda (aguda) arriba · sexta cuerda (grave) abajo</p>
          </div>
        </article>

        
              <article class="surface rounded-2xl p-4 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3"><div><p class="guitar-section-title">Afinación</p><p class="guitar-section-copy mt-1">El diapasón se actualiza con cada afinación.</p></div><div class="flex flex-wrap gap-2" aria-label="Orientación y notación"><button type="button" id="handedness-toggle" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[10px] font-bold transition hover:border-neon hover:text-[var(--accent)]" aria-pressed="false">Mano derecha</button><button type="button" id="accidental-toggle" class="rounded-lg border border-[var(--border)] px-3 py-2 text-[10px] font-bold transition hover:border-neon hover:text-[var(--accent)]" aria-pressed="false">♯ Sostenidos</button></div></div>
          <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">{tuningButtons.map((item) => <button type="button" data-tuning={item.id} aria-pressed={item.id === 'standard' ? 'true' : 'false'} class:list={["tuning-option rounded-xl border px-3 py-3 text-left transition hover:-translate-y-0.5", item.id === 'standard' ? 'is-active border-neon' : 'border-[var(--border)]']}><span class="block text-xs font-bold">{item.label}</span><span class="mt-1 block text-[8px] text-[var(--text-muted)]">{item.tuning}</span></button>)}</div>
        </article>

      </div>

      <aside class="space-y-5">

        <article class="rounded-2xl border border-neon/15 bg-neon/5 p-4 sm:p-5"><p class="guitar-section-title">Cómo leerlo</p><ul class="guitar-section-copy mt-3 space-y-2 leading-5"><li><strong class="text-[var(--text-primary)]">Cada traste</strong> sube un semitono.</li><li><strong class="text-[var(--text-primary)]">Traste 12</strong> repite la nota al aire una octava arriba.</li><li><strong class="text-[var(--text-primary)]">♯ / ♭</strong> cambia la escritura, no el sonido del traste.</li><li><strong class="text-[var(--text-primary)]">Afinaciones</strong> cambian la nota de cada cuerda al aire.</li></ul></article>
        <article class="chord-harmony-card rounded-2xl border border-neon/20 bg-neon/5 p-4 sm:p-5">
          <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="guitar-section-title">Acordes de la escala</p><h2 id="chord-scale-title" class="guitar-section-heading mt-1">Aplica una escala</h2><p class="guitar-section-copy mt-1 leading-5">Selecciona un grado; en Formas 6ª–4ª, pasa o pulsa la tónica para aislar su digitación.</p></div><div class="flex flex-wrap items-end gap-2"><label class="guitar-select-label">Armonía<select id="chord-mode" class="guitar-select"><option value="triad">Tríadas naturales</option><option value="seventh">Con 7ma</option></select></label><button id="chord-voicing-toggle" type="button" class="voicing-toggle" aria-pressed="false" aria-label="Mostrar formas con tónica en las cuerdas sexta, quinta y cuarta" title="Mostrar las formas del acorde desde las cuerdas 6ª, 5ª y 4ª">Formas 6ª–4ª</button></div></div>
          <div id="chord-scale-list" class="mt-4 grid grid-cols-3 gap-2" aria-live="polite"><p class="col-span-3 py-3 text-center text-[9px] text-[var(--text-muted)]">Elige una tonalidad y aplica la escala para ver sus acordes.</p></div>
          <p id="chord-selection-hint" class="mt-3 min-h-4 text-center text-[9px] text-[var(--text-muted)]">El diapasón mostrará las notas del acorde elegido.</p>
        </article>
        <article class="rounded-2xl border border-[var(--border)] bg-[var(--surface-raised)] p-4 sm:p-5">
          <p class="guitar-section-title">Ajustes del diapasón</p>
          <label for="fret-note-size" class="guitar-select-label mt-3">Tamaño de las notas<select id="fret-note-size" class="guitar-select"><option value="1">Normal</option><option value="1.15">Grande · 115%</option><option value="1.3">Más grande · 130%</option><option value="1.45">Máximo · 145%</option></select></label>
          <label class="guitar-interval-toggle mt-3"><span>Mostrar intervalos</span><input id="show-note-intervals" type="checkbox"><span class="text-xs font-normal text-[var(--text-muted)]">(III)</span></label>
          <p class="guitar-section-copy mt-2 leading-5">Muestra el grado y la calidad del intervalo debajo de cada nota resaltada.</p>
        </article>
        <a href="/herramientas" class="block rounded-xl border border-[var(--border)] px-4 py-3 text-center text-[10px] font-bold text-[var(--text-muted)] transition hover:border-neon hover:text-[var(--accent)]">Ir a las herramientas musicales →</a>
      </aside>
    </section>
<section class="greek-reference"><main class="gref-wrap"><h2>Modos griegos en el diapasón</h2><p class="gref-sub">Afinación estándar E A D G B e · trastes 0 a 15</p><div class="gref-controls"><div class="gref-modes" id="gref-modes" role="group" aria-label="Modo"></div><label>Tónica <select id="gref-root"></select></label><div class="gref-seg"><button id="gref-notes" type="button" aria-pressed="true">Notas</button><button id="gref-degrees" type="button" aria-pressed="false">Grados</button></div></div><section class="gref-info" aria-live="polite"><h3 id="gref-title"></h3><p class="gref-par" id="gref-parent"></p><div class="gref-degs" id="gref-degs"></div><p class="gref-char" id="gref-char"></p></section><div class="gref-scroll"><div class="gref-board" id="gref-board"></div></div><p class="gref-hint">El círculo con aro es la tónica. Cada color es un grado.</p></main></section>
  </main>
<style is:global>.guitar-section-title{color:var(--accent);font-size:1.5rem;font-weight:800;letter-spacing:.12em;line-height:1.25;text-transform:uppercase}.guitar-section-heading{font-size:1.5rem;font-weight:800;line-height:1.25}.guitar-section-copy{color:var(--text-muted);font-size:.85rem}.guitar-select-label{display:grid;gap:.4rem;color:var(--text-primary);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.guitar-select{min-height:2.75rem;min-width:8rem;border:1px solid rgb(99 245 140 / .42);border-radius:.7rem;background:#10271a;padding:.65rem .8rem;color:#f2fff5;font:600 .9rem 'Space Mono',monospace;letter-spacing:normal;text-transform:none;box-shadow:inset 0 0 0 1px rgb(255 255 255 / .035);transition:border-color .18s,background .18s,box-shadow .18s,transform .18s}.guitar-select:hover{border-color:#63f58c;background:#163322;box-shadow:0 0 0 3px rgb(99 245 140 / .13),0 0 18px rgb(99 245 140 / .12);transform:translateY(-1px)}.guitar-select:focus-visible{outline:2px solid #9affb6;outline-offset:2px}.guitar-select option{background:#10271a;color:#f2fff5}.guitar-interval-toggle{display:flex;min-height:2.75rem;align-items:center;gap:.8rem;border:1px solid rgb(99 245 140 / .42);border-radius:.7rem;padding:.65rem .8rem;color:#f2fff5;font-size:.85rem;font-weight:700;transition:border-color .18s,background .18s,box-shadow .18s,transform .18s}.guitar-interval-toggle:hover{border-color:#63f58c;background:rgb(99 245 140 / .08);box-shadow:0 0 16px rgb(99 245 140 / .13);transform:translateY(-1px)}.guitar-interval-toggle input{width:1.15rem;height:1.15rem;accent-color:#63f58c}.greek-reference{--bg:#08150f;--panel:#0d1f16;--line:#1f3a2c;--text:#d9ecdf;--mute:#7fa08b;--string:#9db8a6;--fret:#2c4d3b;--cell:56px;background:var(--bg);color:var(--text);font-family:'Space Mono',monospace;padding:28px 20px 48px}.greek-reference *{box-sizing:border-box;margin:0}.greek-reference .gref-wrap{max-width:1000px;margin:auto}.greek-reference h2{font-family:'Space Mono',monospace;font-size:1.5rem;color:var(--accent,#63f58c)}.greek-reference .gref-sub{color:var(--mute);font-size:.85rem;margin-top:4px}.greek-reference .gref-controls{display:flex;flex-wrap:wrap;gap:14px 20px;align-items:center;margin:22px 0 18px}.greek-reference .gref-modes{display:flex;flex-wrap:wrap;gap:6px}.greek-reference button,.greek-reference select{font:inherit;color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:8px 12px;cursor:pointer;font-size:.8rem}.greek-reference button[aria-pressed=true]{background:var(--text);color:var(--bg);font-weight:700}.greek-reference .gref-seg{display:flex}.greek-reference .gref-seg button{border-radius:0}.greek-reference .gref-seg button:first-child{border-radius:6px 0 0 6px}.greek-reference .gref-seg button:last-child{border-radius:0 6px 6px 0}.greek-reference label{color:var(--mute);font-size:.8rem;display:flex;gap:8px;align-items:center}.greek-reference .gref-info{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:18px 20px;margin-bottom:18px}.greek-reference .gref-info h3{font-family:'Space Mono',monospace;font-size:1.5rem;color:var(--accent,#63f58c)}.greek-reference .gref-par{color:var(--mute);font-size:.85rem;margin:3px 0 14px}.greek-reference .gref-degs{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.greek-reference .gref-deg{border-top:3px solid var(--c);padding-top:8px}.greek-reference .gref-deg b{display:block;font-size:1.25rem}.greek-reference .gref-deg span{color:var(--mute);font-size:.75rem}.greek-reference .gref-char{margin-top:14px;color:var(--mute);font-size:.85rem;line-height:1.5;max-width:70ch}.greek-reference .gref-scroll{overflow-x:auto;padding-bottom:10px;background:var(--panel);border:1px solid var(--line);border-radius:10px}.greek-reference .gref-board{display:grid;grid-template-columns:repeat(16,var(--cell));min-width:calc(var(--cell)*16);padding:12px 8px 6px}.greek-reference .gref-cell{height:44px;position:relative;display:flex;align-items:center;justify-content:center;border-right:2px solid var(--fret)}.greek-reference .gref-cell:before{content:'';position:absolute;left:0;right:0;top:50%;height:var(--t);background:var(--string);opacity:.55}.greek-reference .gref-cell.f0{border-right:5px solid var(--text)}.greek-reference .gref-cell.f0:before{left:50%}.greek-reference .gref-sl{position:absolute;left:0;color:var(--mute);font-size:.65rem}.greek-reference .gref-note{position:relative;z-index:1;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-size:.72rem;font-weight:700;color:#06120b;background:var(--c);transition:transform .15s}.greek-reference .gref-note:hover{transform:scale(1.15)}.greek-reference .gref-note.root{box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--c)}.greek-reference .gref-note.open{width:30px;height:30px}.greek-reference .gref-num{height:26px;text-align:center;font-size:.72rem;color:var(--mute);display:flex;align-items:center;justify-content:center}.greek-reference .gref-mk{height:22px;display:flex;align-items:center;justify-content:center;gap:6px}.greek-reference .gref-mk i{width:8px;height:8px;border-radius:50%;background:var(--fret)}.greek-reference .gref-hint{color:var(--mute);font-size:.75rem;margin-top:10px}@media(max-width:640px){.greek-reference .gref-degs{grid-template-columns:repeat(4,1fr)}}
</style></BaseLayout>

<style>
  .fretboard-panel { --accent: #63f58c; --zen-zoom:1.2; position:relative; padding-top:3.5rem; overflow: hidden; border: 1px solid rgb(99 245 140 / .22); background: linear-gradient(145deg, #0a1b11, #07100b 65%, #0d1b12); }
  .fretboard-panel:fullscreen, .fretboard-panel.is-app-fullscreen { box-sizing:border-box; position:fixed; z-index:100; inset:0; width:100vw; max-width:none; height:100vh; height:100dvh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem; overflow:auto; padding:clamp(.75rem,3vw,3rem); border:0; border-radius:0; background:#07100b; }
  .fretboard-panel:fullscreen .fretboard-scroll, .fretboard-panel.is-app-fullscreen .fretboard-scroll { width:100%; max-width:100%; }
  .fretboard-panel:fullscreen .fretboard, .fretboard-panel.is-app-fullscreen .fretboard { margin-inline:auto; }
  .fretboard-panel:fullscreen .fret-row, .fretboard-panel.is-app-fullscreen .fret-row { margin-inline:auto; }
  .zen-header { display:none; }
  .fretboard-panel:fullscreen .zen-header, .fretboard-panel.is-app-fullscreen .zen-header { display:grid; width:min(100%,1500px); gap:.9rem; margin-inline:auto; }
  .zen-topline { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.9rem; }
  .zen-kicker { color:#72ff9b; font-size:.62rem; font-weight:800; letter-spacing:.2em; }
  .zen-scale-title { margin-top:.2rem; color:#f4fff7; font-size:clamp(1.15rem,2.4vw,2rem); font-weight:900; }
  .zen-zoom-control { display:grid; gap:.35rem; color:rgb(235 255 241 / .65); font-size:.58rem; font-weight:700; text-transform:uppercase; letter-spacing:.12em; }
  .zen-zoom-options { display:flex; flex-wrap:wrap; gap:.35rem; }
  .zen-zoom-options button { min-width:3.1rem; border:1px solid rgb(114 255 155 / .25); border-radius:.65rem; padding:.45rem .6rem; color:#d8f5df; font-size:.65rem; letter-spacing:normal; transition:background .18s,color .18s,border-color .18s,transform .18s; }
  .zen-zoom-options button:hover { transform:translateY(-1px); border-color:#72ff9b; }
  .zen-zoom-options button.is-active { border-color:#72ff9b; color:#07100b; background:#72ff9b; box-shadow:0 0 16px rgb(114 255 155 / .3); }
  .zen-scale-notes { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
  .zen-scale-note { display:grid; min-width:3.4rem; gap:.15rem; justify-items:center; border:1px solid rgb(114 255 155 / .2); border-radius:.75rem; padding:.4rem .6rem; background:rgb(114 255 155 / .055); }
  .zen-scale-note strong { color:#baffc9; font-size:.78rem; }
  .zen-scale-note small, .zen-empty { color:rgb(235 255 241 / .62); font-size:.56rem; }
  .fretboard-panel.is-zen-mode .fretboard { zoom:var(--zen-zoom,1.2); }
  .scale-context { border:1px solid rgb(126 231 255 / .28); border-radius:999px; padding:.3rem .55rem; color:#a6efff; font-size:.58rem; font-weight:700; }
  .fretboard-panel > .fullscreen-button { position:absolute; top:.7rem; left:.7rem; z-index:5; }
  .fullscreen-button { display:grid; width:2.5rem; height:2.5rem; place-items:center; border:1px solid rgb(99 245 140 / .35); border-radius:.75rem; color:#63f58c; transition:background .2s,transform .2s,box-shadow .2s; }
  .fullscreen-button:hover { transform:scale(1.06); background:rgb(99 245 140 / .12); box-shadow:0 0 18px rgb(99 245 140 / .25); }

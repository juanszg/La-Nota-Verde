    const initGreekReference=()=>{const MODES=[{n:'Jónico',s:[0,2,4,5,7,9,11],c:'Es la escala mayor. Sonido estable y brillante; la tónica resuelve sin tensión.'},{n:'Dórico',s:[0,2,3,5,7,9,10],c:'Menor con sexta mayor. Suena jazzero y algo luminoso; típico del funk y el rock modal.'},{n:'Frigio',s:[0,1,3,5,7,8,10],c:'Menor con segunda menor. Aire español y oscuro; la 2ª♭ marca su carácter.'},{n:'Lidio',s:[0,2,4,6,7,9,11],c:'Mayor con cuarta aumentada. Sonido flotante y soñador, muy usado en cine.'},{n:'Mixolidio',s:[0,2,4,5,7,9,10],c:'Mayor con séptima menor. Bluesero y rockero; es el modo del acorde dominante.'},{n:'Eolio',s:[0,2,3,5,7,8,10],c:'Es la escala menor natural. Sonido triste y estable.'},{n:'Locrio',s:[0,1,3,5,6,8,10],c:'Menor con 2ª♭ y 5ª disminuida. El más inestable; la tónica casi no se sostiene.'}];const ROM=['I','II','III','IV','V','VI','VII'],LET=['C','D','E','F','G','A','B'],LPC=[0,2,4,5,7,9,11],ROOTS=['C','C♯','D','E♭','E','F','F♯','G','A♭','A','B♭','B'],STR=[['e',4],['B',11],['G',7],['D',2],['A',9],['E',4]],MARK={3:1,5:1,7:1,9:1,12:2,15:1},COL=['#ff6b6b','#ffa94d','#ffe066','#8ce99a','#66d9e8','#91a7ff','#da77f2'];let mode=0,root='C',degrees=false;const acc=d=>({'-2':'𝄫','-1':'♭','0':'','1':'♯','2':'𝄪'})[d]||'';const parse=r=>{let li=LET.indexOf(r[0]),a=r[1]==='♯'?1:r[1]==='♭'?-1:0;return{li,pc:(LPC[li]+a+12)%12}};const makeScale=()=>{let{li,pc}=parse(root);return MODES[mode].s.map((st,d)=>{let l=(li+d)%7,p=(pc+st)%12,diff=((p-LPC[l]+18)%12)-6,di=st-[0,2,4,5,7,9,11][d],q=[0,3,4].includes(d)?(di===0?'J':di<0?'dis':'aum'):(di===0?'M':di<0?'m':'aum');return{pc,name:LET[l]+acc(diff),deg:d,lab:(d+1)+'ª '+q}})};const draw=()=>{let sc=makeScale(),rootPc=parse(root).pc;document.querySelector('#gref-title').textContent=`Modo ${ROM[mode]} · ${MODES[mode].n} de ${root}`;document.querySelector('#gref-parent').textContent='Notas: '+sc.map(n=>n.name).join(' · ');document.querySelector('#gref-degs').innerHTML=sc.map(n=>`<div class="gref-deg" style="--c:${COL[
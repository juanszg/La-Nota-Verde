---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Empieza tu camino musical — LA NOTA VERDE" description="Cuéntanos qué te mueve y descubre cómo empezar a aprender música.">
  <section class="app-grid grid min-h-[60vh] place-items-center px-6 py-16 text-center lg:px-8"><div class="max-w-2xl"><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Tu historia comienza aquí</p><h1 class="page-title mt-4 text-5xl font-bold sm:text-6xl">Empezar</h1><p class="mt-5 text-sm leading-7 text-[var(--text-muted)]">El cuestionario ahora está en la página principal para que puedas encontrarlo enseguida.</p><div class="mt-8 flex justify-center"><Button href="/#empezar">Ir al cuestionario</Button></div></div></section>
</BaseLayout>

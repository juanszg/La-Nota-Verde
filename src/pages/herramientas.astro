---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolsSection from '../components/home/ToolsSection.astro';
---
<BaseLayout title="Herramientas — LA NOTA VERDE" description="Afinador, acordes de séptima y práctica de solfeo.">
  <div class="app-grid min-h-[30vh] px-6 pb-4 pt-14 lg:px-8"><div class="mx-auto max-w-7xl text-center"><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Tu estación de práctica</p><h1 class="page-title mt-4 text-5xl font-bold sm:text-6xl">Herramientas</h1><p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[var(--text-muted)]">Todo lo necesario para afinar, descubrir acordes y entrenar tu oído.</p></div></div>
  <ToolsSection />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningSection from '../components/home/LearningSection.astro';
---
<BaseLayout title="Aprender — LA NOTA VERDE" description="Temarios de música y técnicas de guitarra para crear tu propio sonido.">
  <div class="app-grid min-h-[30vh] px-6 pb-4 pt-14 lg:px-8"><div class="mx-auto max-w-7xl text-center"><p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Rutas para encontrar tu sonido</p><h1 class="page-title mt-4 text-5xl font-bold sm:text-6xl">Aprender</h1><p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-[var(--text-muted)]">Explora los fundamentos musicales y lleva tu técnica de guitarra al siguiente nivel.</p></div></div>
  <LearningSection />
</BaseLayout>
